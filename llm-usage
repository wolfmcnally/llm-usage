def next_data_refresh_deadline(code: int | None, age: float | None,
                               loaded_at: float,
                               provider: str | None = None) -> float:
    if code == 200:
        ttl = cache_ttl(provider)
    elif code == 429:
        ttl = rate_limit_ttl()
    else:
        return loaded_at + DEFAULT_TUI_RETRY_SECONDS
    if ttl <= 0:
        return loaded_at + DEFAULT_TUI_RETRY_SECONDS
    return loaded_at + max(1.0, ttl - (age or 0.0))


def snapshot_elapsed(snapshot: dict) -> float:
    return max(0.0, time.time() - float(snapshot.get("loaded_at", time.time())))


def displayed_cache_age(snapshot: dict, include_live_429: bool = False
                        ) -> float | None:
    age = snapshot.get("age")
    if age is not None:
        return float(age) + snapshot_elapsed(snapshot)
    if include_live_429 and snapshot.get("code") == 429:
        return snapshot_elapsed(snapshot)
    return None


def _limit_key_part(value: str) -> str:
    part = re.sub(r"[^a-z0-9]+", "_", value.lower()).strip("_")
    return part or "scoped"


def anthropic_limit_bands(body: dict) -> list[dict]:
    """Normalize Anthropic's generic limits, with legacy-key fallbacks.

    Current responses describe session, all-model weekly, and scoped weekly
    limits in `limits[]`. Older responses expose the same data through named
    top-level fields. Prefer the generic representation so new models and
    surfaces do not require hard-coded rollout names, then fill any missing
    bands from the stable legacy keys.
    """
    bands = []
    seen = set()

    def add(key: str, label: str, utilization: Any, resets_at: Any,
            window_seconds: int, kind: str, group: str | None = None,
            is_active: bool | None = None,
            severity: str | None = None, source: str = "limits") -> None:
        if key in seen:
            return
        try:
            usage = float(utilization or 0)
        except (TypeError, ValueError):
            usage = 0.0
        bands.append({
            "key": key,
            "label": label,
            "utilization": usage,
            "resets_at": resets_at,
            "window_seconds": window_seconds,
            "kind": kind,
            "group": group,
            "is_active": is_active,
            "severity": severity,
            "source": source,
        })
        seen.add(key)

    for limit in body.get("limits") or []:
        if not isinstance(limit, dict):
            continue
        kind = limit.get("kind")
        if kind == "session":
            key, label, window_seconds = "five_hour", "5-hour", 5 * 3600
        elif kind == "weekly_all":
            key, label, window_seconds = (
                "seven_day", "7-day overall", 7 * 86400)
        elif kind == "weekly_scoped":
            scope = limit.get("scope") or {}
            if not isinstance(scope, dict):
                scope = {}
            model_data = scope.get("model") or {}
            if not isinstance(model_data, dict):
                model_data = {}
            model = model_data.get("display_name")
            what = model or scope.get("surface") or "scoped"
            key = "seven_day_" + _limit_key_part(str(what))
            label, window_seconds = f"7-day {what}", 7 * 86400
        else:
            continue
        active = limit.get("is_active")
        add(
            key, label, limit.get("percent"), limit.get("resets_at"),
            window_seconds, str(kind), limit.get("group"),
            bool(active) if active is not None else None,
            limit.get("severity"),
        )

    legacy = [
        ("seven_day", "7-day overall", "weekly_all", 7 * 86400),
        ("seven_day_sonnet", "7-day Sonnet", "weekly_scoped", 7 * 86400),
        ("seven_day_opus", "7-day Opus", "weekly_scoped", 7 * 86400),
        ("seven_day_oauth_apps", "7-day OAuth apps", "weekly_scoped",
         7 * 86400),
        ("seven_day_cowork", "7-day cowork", "weekly_scoped", 7 * 86400),
        ("five_hour", "5-hour", "session", 5 * 3600),
    ]
    for key, label, kind, window_seconds in legacy:
        data = body.get(key)
        if not isinstance(data, dict):
            continue
        add(
            key, label, data.get("utilization"), data.get("resets_at"),
            window_seconds, kind, source="legacy",
        )

    priority = {"weekly_all": 0, "weekly_scoped": 1, "session": 2}
    bands.sort(key=lambda band: priority.get(band["kind"], 3))
    return bands


def normalize_money(value: Any, default_currency: str | None = None
                    ) -> dict | None:
    if not isinstance(value, dict):
        return None
    amount_minor = value.get("amount_minor")
    exponent = value.get("exponent", 2)
    if not isinstance(amount_minor, (int, float)) \
            or isinstance(amount_minor, bool):
        return None
    if not isinstance(exponent, int) or isinstance(exponent, bool):
        exponent = 2
    exponent = max(0, min(exponent, 9))
    currency = value.get("currency") or default_currency
    return {
        "amount": float(amount_minor) / (10 ** exponent),
        "amount_minor": amount_minor,
        "currency": currency,
        "exponent": exponent,
    }


def normalize_anthropic_spend(body: dict) -> dict | None:
    """Normalize current `spend`, falling back to legacy `extra_usage`."""
    spend = body.get("spend")
    if isinstance(spend, dict) and spend:
        limit = normalize_money(spend.get("limit"))
        currency = limit.get("currency") if limit else None
        cap = spend.get("cap") or {}
        if not isinstance(cap, dict):
            cap = {}
        cap_value = normalize_money(cap.get("money"), currency)
        if cap_value is None:
            cap_value = normalize_money(cap.get("credits"), currency)
        return {
            "source": "spend",
            "enabled": bool(spend.get("enabled")),
            "used": normalize_money(spend.get("used"), currency),
            "limit": limit or cap_value,
            "cap": cap_value,
            "balance": normalize_money(spend.get("balance"), currency),
            "percent": (float(spend.get("percent"))
                        if isinstance(spend.get("percent"), (int, float))
                        and not isinstance(spend.get("percent"), bool)
                        else None),
            "severity": spend.get("severity"),
            "disabled_reason": spend.get("disabled_reason"),
            "auto_reload": spend.get("auto_reload"),
            "can_purchase_credits": bool(spend.get("can_purchase_credits")),
            "can_toggle": bool(spend.get("can_toggle")),
            "disclaimer": spend.get("disclaimer"),
        }

    extra = body.get("extra_usage")
    if not isinstance(extra, dict):
        return None
    exponent = extra.get("decimal_places", 2)
    if not isinstance(exponent, int) or isinstance(exponent, bool):
        exponent = 2
    currency = extra.get("currency")

    def legacy_money(value: Any) -> dict | None:
        if not isinstance(value, (int, float)) or isinstance(value, bool):
            return None
        return normalize_money({
            "amount_minor": value,
            "currency": currency,
            "exponent": exponent,
        })

    percent = extra.get("utilization")
    return {
        "source": "extra_usage",
        "enabled": bool(extra.get("is_enabled")),
        "used": legacy_money(extra.get("used_credits")),
        "limit": legacy_money(extra.get("monthly_limit")),
        "cap": legacy_money(extra.get("monthly_limit")),
        "balance": None,
        "percent": (float(percent)
                    if isinstance(percent, (int, float))
                    and not isinstance(percent, bool) else None),
        "severity": None,
        "disabled_reason": extra.get("disabled_reason"),
        "auto_reload": None,
        "can_purchase_credits": False,
        "can_toggle": False,
        "disclaimer": None,
    }


def format_money(value: dict | None) -> str | None:
    if not value:
        return None
    amount = value.get("amount")
    if not isinstance(amount, (int, float)):
        return None
    currency = value.get("currency") or ""
    symbol = {"USD": "$", "EUR": "€", "GBP": "£"}.get(currency)
    number = f"{amount:,.{min(int(value.get('exponent', 2)), 4)}f}"
    return f"{symbol}{number}" if symbol else f"{number} {currency}".strip()


def anthropic_spend_status_line(body: dict) -> str | None:
    spend = normalize_anthropic_spend(body)
    if not spend:
        return None
    used_money = spend.get("used") or {}
    used_amount = used_money.get("amount")
    has_spend = (isinstance(used_amount, (int, float))
                 and not isinstance(used_amount, bool)
                 and used_amount > 0)
    reason = spend.get("disabled_reason")
    severity = spend.get("severity")
    actionable_severity = severity not in (None, "normal")
    if not (spend["enabled"] or has_spend or actionable_severity):
        return None

    parts = []
    if spend["enabled"]:
        parts.append(f"{fg256(78)}usage credits on{RESET}")
    else:
        parts.append(f"{SUB_FG}usage credits off{RESET}")
