def provider_view(provider: str, snapshot: dict) -> dict:
    """Build the provider view every surface renders from.

    The result is the provider's `--json` object: normalized data for
    consumers plus a `display` block holding every presentation decision
    (title, plan, header notices, service line, error, alerts, extras, and
    rows with severity and pace). The terminal and the HTML page only map
    tones to colors and lay the display block out. Build it at render time:
    notice clocks and countdowns are computed against the current time.
    """
    meta = PROVIDERS[provider]
    service_status = provider_status_json(snapshot.get("service_status"))
    plan = (meta["plan"](snapshot) or "").title()
    display: dict[str, Any] = {
        "title": meta["title"],
        "plan": f"{meta['brand']} {plan} Plan" if plan else meta["brand"],
        "notices": [],
        "service": service_status_segment(snapshot.get("service_status")),
        "error": None,
        "alerts": [],
        "extras": [],
        "rows": [],
    }
    tok = snapshot.get("token")
    if not tok or not tok.get("access_token"):
        display["plan"] = meta["brand"]
        display["error"] = (f"no OAuth token (set ${meta['token_env']} or "
                            f"run `{meta['cli']}` to login)")
        return {"ok": False, "error": "no OAuth token", "windows": {},
                "cached": False, "cache_age_seconds": None,
                "service_status": service_status, "display": display}

    code, age = snapshot.get("code"), snapshot.get("age")
    expiry, expired = token_expiry_notice(tok.get("expires_at_ms"))
    if code == 429:
        status = rate_limit_notice(
            displayed_cache_age(snapshot, include_live_429=True))
    else:
        status = cache_notice(code, displayed_cache_age(snapshot))
    display["notices"] = [n for n in (status, expiry) if n]

    if code == 200:
        view = meta["data"](snapshot, display)
    else:
        if code == 401:
            display["error"] = ("token rejected (401)"
                                + (" — expired" if expired else "")
                                + f"; run `{meta['cli']}` to refresh")
        elif code != 429:
            body = snapshot.get("body") or {}
            display["error"] = f"API error {code}: {json.dumps(body)[:200]}"
        view = {"ok": False,
                "error": ("rate limited (429)" if code == 429
                          else f"API error {code}"),
                "windows": {},
                "rate_limited": code == 429,
                "oauth_expires_at_ms": tok.get("expires_at_ms")}
    view.update({"cached": age is not None, "cache_age_seconds": age,
                 "service_status": service_status, "display": display})
    return view


def render_provider_section(view: dict, width: int
                            ) -> tuple[list[str], bool]:
    """Lay a provider view out as terminal lines. Returns lines plus ok."""
    d = view["display"]
    lines = section_header(
        d["title"], d["plan"], width,
        [seg_ansi(notice, "[", "]") for notice in d["notices"]])
    if d["service"]:
        lines.append("  " + seg_ansi(d["service"]))
    if d["error"]:
        lines.append(warn_line(d["error"]))
    if not view["ok"]:
        return [clip_ansi(line, width) for line in lines], False

    extras = extras_line(d["extras"])
    if extras:
        lines.append(extras)
    lines.extend("  " + seg_ansi(alert) for alert in d["alerts"])
    rows = [item for item in d["rows"] if item["type"] == "row"]
    label_w, pct_w = row_layout_widths(rows, width)
    for item in d["rows"]:
        if item["type"] == "heading":
            lines.append(f"  {DIM}{item['text']}{RESET}" + "".join(
                "  " + seg_ansi(badge) for badge in item["badges"]))
        else:
            lines.extend(row(item, width, label_w, pct_w).splitlines())
    if not rows:
        lines.append(f"  {DIM}(no usage data){RESET}")
    return [clip_ansi(line, width) for line in lines], True


def _provider_json(provider: str, snapshot_fn,
                   service_status_snapshot: dict | None) -> dict:
    snapshot = snapshot_fn()
    snapshot["service_status"] = (
        service_status_snapshot if service_status_snapshot is not None
        else provider_status_snapshot(provider))
    return provider_view(provider, snapshot)


def _anthropic_json(service_status_snapshot: dict | None = None) -> dict:
    return _provider_json("anthropic", anthropic_snapshot,
                          service_status_snapshot)


def _openai_json(service_status_snapshot: dict | None = None) -> dict:
    return _provider_json("openai", openai_snapshot, service_status_snapshot)


def emit_json() -> int:
    snapshot = load_dashboard_snapshot()
    a = provider_view("anthropic", snapshot["anthropic"])
    o = provider_view("openai", snapshot["openai"])
    print(json.dumps({"anthropic": a, "openai": o}, indent=2))
    return dashboard_exit_code(a["ok"], o["ok"])


# ------------------------------------------------------------ html output ----
#
# `--html` serves a display-only browser dashboard from a loopback HTTP server
# and opens it in the preferred browser; the page re-renders locally every
# second (countdowns, pace tick) and polls /data.json every minute, which runs
# `llm-usage --json` as a subprocess — so the HTML surface consumes exactly the
# same cache-aware source of truth as every other consumer, and the endpoints
# are still hit at most once per TTL window. `--html-static <path>` writes one
# self-contained snapshot page (payload embedded, polling disabled) so an agent
# can open it or screenshot it. Both are read-only surfaces with no controls.
