def status_ttl() -> int:
    """Persistent public-status cache TTL; zero disables all caching."""
    if _caching_off():
        return 0
    value = _env_int("LLM_USAGE_STATUS_TTL")
    return value if value is not None and value >= 0 else DEFAULT_STATUS_TTL


def _read_cache_document(cache_key: str) -> dict | None:
    try:
        with open(_cache_path(cache_key)) as f:
            document = json.load(f)
    except (OSError, json.JSONDecodeError):
        return None
    return document if isinstance(document, dict) else None


def _write_cache_document(cache_key: str, document: dict) -> None:
    """Atomically persist a cache document; failures never break rendering."""
    file_path = _cache_path(cache_key)
    tmp = f"{file_path}.{os.getpid()}.tmp"
    try:
        os.makedirs(_cache_dir(), exist_ok=True)
        with open(tmp, "w") as f:
            json.dump(document, f)
        os.replace(tmp, file_path)  # atomic — concurrent runs never see a partial
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def _retry_after_seconds(value: str | None, now: float) -> float | None:
    if not value:
        return None
    try:
        return max(0.0, float(value))
    except ValueError:
        pass
    try:
        retry_at = email.utils.parsedate_to_datetime(value)
        if retry_at.tzinfo is None:
            retry_at = retry_at.replace(tzinfo=timezone.utc)
        return max(0.0, retry_at.timestamp() - now)
    except (TypeError, ValueError, OverflowError):
        return None


def _status_retry_seconds(failures: int, retry_after: str | None,
                          now: float) -> float:
    explicit = _retry_after_seconds(retry_after, now)
    if explicit is not None:
        return max(1.0, explicit)
    base = min(
        MAX_STATUS_RETRY_TTL,
        DEFAULT_STATUS_RETRY_TTL * (3 ** max(0, failures - 1)),
    )
    return max(1.0, base * random.uniform(0.9, 1.1))


def normalize_provider_status(provider: str, body: Any) -> dict | None:
    """Normalize the shared Statuspage-style summary response."""
    if not isinstance(body, dict):
        return None
    raw_status = body.get("status")
    if not isinstance(raw_status, dict):
        return None
    indicator = str(raw_status.get("indicator") or "unknown").lower()
    description = str(
        raw_status.get("description") or "Status unavailable").strip()
    affected = []
    for component in body.get("components") or []:
        if not isinstance(component, dict):
            continue
        component_state = str(
            component.get("status") or "unknown").lower()
        if component_state != "operational":
            affected.append({
                "name": str(component.get("name") or "Unknown component"),
                "status": component_state,
            })
    return {
        "provider": provider,
        "indicator": indicator,
        "description": description,
        "operational": indicator == "none" and not affected,
        "affected_components": affected,
    }


def _status_error_text(code: int | None, body: Any) -> str:
    if code is None:
        if isinstance(body, dict) and body.get("error"):
            return str(body["error"])
        return "network error"
    if code == 200:
        return "invalid status response"
    return f"HTTP {code}"


def provider_status_snapshot(provider: str) -> dict:
    """Load a provider's public status with caching and stale-if-error.

    A successful response is reused for at least a minute across processes.
    Failed refreshes retain the last known state and establish a persistent,
    escalating retry deadline so repeated CLI launches cannot hammer the site.
    """
    loaded_at = time.time()
    cache_key = f"status-{provider}"
    ttl = status_ttl()
    cached = (_read_cache_document(cache_key) if ttl > 0 else None) or {}
    cached_body = cached.get("body")
    cached_ts = cached.get("ts")
    retry_at = cached.get("retry_at")

    def result(body: Any, *, cached_flag: bool, stale: bool,
               age: float | None, error: str | None, deadline: float) -> dict:
        return {
            "provider": provider,
            "status": normalize_provider_status(provider, body),
            "cached": cached_flag,
            "stale": stale,
            "age": age,
            "error": error,
            "loaded_at": loaded_at,
            "deadline": deadline,
        }

    def stale_result(error: str, deadline: float) -> dict:
        age = (max(0.0, loaded_at - cached_ts)
               if isinstance(cached_ts, (int, float)) else None)
        return result(cached_body, cached_flag=cached_body is not None,
                      stale=True, age=age, error=error, deadline=deadline)

    if (not _CACHE_READ_BYPASS and isinstance(retry_at, (int, float))
            and retry_at > loaded_at):
        return stale_result(cached.get("last_error") or "status refresh failed",
                            float(retry_at))

    if (not _CACHE_READ_BYPASS and ttl > 0
            and isinstance(cached_ts, (int, float))
            and loaded_at >= cached_ts
            and loaded_at - cached_ts <= ttl):
        return result(cached_body, cached_flag=True, stale=False,
                      age=loaded_at - cached_ts, error=None,
                      deadline=cached_ts + ttl)

    headers = {
        "Accept": "application/json",
        "User-Agent": "llm-usage/1 status-monitor",
    }
    if cached.get("etag"):
        headers["If-None-Match"] = str(cached["etag"])
    code, body, response_headers = http_get_json_response(
        STATUS_URLS[provider], headers)

    not_modified = code == 304 and cached_body is not None
    if not_modified or (
            code == 200 and normalize_provider_status(provider, body) is not None):
        fresh_body = cached_body if not_modified else body
        etag = response_headers.get("etag")
        if not_modified:
            etag = etag or cached.get("etag")
        if ttl > 0:
            _write_cache_document(cache_key, {
                "ts": loaded_at,
                "body": fresh_body,
                "etag": etag,
                "failures": 0,
                "retry_at": None,
                "last_error": None,
            })
        return result(fresh_body, cached_flag=not_modified, stale=False,
                      age=0.0 if not_modified else None, error=None,
                      deadline=loaded_at + max(1, ttl or DEFAULT_STATUS_TTL))

    failures = max(0, int(cached.get("failures") or 0)) + 1
    retry_at = loaded_at + _status_retry_seconds(
        failures, response_headers.get("retry-after"), loaded_at)
    error = _status_error_text(code, body)
    if ttl > 0:
        document = dict(cached)
        document.update({
            "failures": failures,
            "retry_at": retry_at,
            "last_error": error,
            "last_attempt": loaded_at,
        })
        _write_cache_document(cache_key, document)
    return stale_result(error, retry_at)


def provider_status_json(snapshot: dict | None) -> dict:
    snapshot = snapshot or {}
    normalized = snapshot.get("status")
    status = normalized or {}
    return {
        "available": normalized is not None,
        "operational": status.get("operational"),
        "indicator": status.get("indicator"),
        "description": status.get("description"),
        "affected_components": status.get("affected_components", []),
        "cached": bool(snapshot.get("cached")),
        "stale": bool(snapshot.get("stale")),
        "cache_age_seconds": snapshot.get("age"),
        "error": snapshot.get("error"),
        "page_url": STATUS_PAGE_URLS.get(str(snapshot.get("provider") or "")),
    }


def service_status_segment(snapshot: dict | None) -> dict | None:
    """The public-status line for a provider, or None when all is well."""
    snapshot = snapshot or {}
    normalized = snapshot.get("status")
    stale = bool(snapshot.get("stale"))
    error = snapshot.get("error")
    link = STATUS_PAGE_URLS.get(str(snapshot.get("provider") or ""))
    if normalized is None:
        if error:
            return seg(f"? Service status unavailable ({error})", "warn",
                       link=link)
        return None

    if normalized.get("operational") and not stale:
        return None
    indicator = normalized.get("indicator")
    if indicator in ("major", "critical"):
        tone = "critical"
    elif indicator == "minor":
        tone = "warn"
    else:
        tone = "caution"
    text = str(normalized.get("description") or "Service disruption")
    if not stale:
        return seg(f"● Service status: {text}", tone, link=link)
    if normalized.get("operational"):
        text = f"? Service status unavailable; last known: {text}"
        tone = "warn"
    else:
        text = f"● Service status: {text}"
    age = snapshot.get("age")
    if isinstance(age, (int, float)):
        return seg(f"{text}, last confirmed ", tone, age, "up", " ago",
                   link=link)
    return seg(f"{text}, last confirmed earlier", tone, link=link)


def provider_status_line(snapshot: dict | None) -> str | None:
    segment = service_status_segment(snapshot)
    return "  " + seg_ansi(segment) if segment else None


# ----------------------------------------------------------- bar render ----

FULL = "█"
EMPTY = "░"
NOW_MARK = "▼"


def render_bar(width: int, usage_pct: float) -> tuple[str, bool]:
    """Return (bar_string, overflow). Width is total cells."""
    width = max(width, 4)
    overflow = usage_pct > 100
    fill_cells = round(min(max(0, usage_pct), 100) / 100 * width)
    color = color_for_pct(usage_pct)
    cells = []
    for i in range(width):
        if i < fill_cells:
            cells.append(color + FULL + RESET)
        else:
            cells.append(DIM_GRAY + EMPTY + RESET)
    return "".join(cells), overflow


# ---------------------------------------------------------- time helpers ----

def parse_iso(s: str | None) -> datetime | None:
    if not s:
        return None
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    try:
        return datetime.fromisoformat(s)
    except ValueError:
        return None


def fmt_local(dt: datetime | None) -> str:
    if not dt:
        return "—"
    return dt.astimezone().strftime("%a %b %d %H:%M %Z")


def fmt_relative(seconds: float | None) -> str:
    if seconds is None:
        return "—"
    s = int(max(0, seconds))
    d, rem = divmod(s, 86400)
    h, rem = divmod(rem, 3600)
    m, _ = divmod(rem, 60)
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m:02d}m"
    return f"{m}m"


def fmt_window(seconds: int) -> str:
    if seconds % 86400 == 0 and seconds >= 86400:
        d = seconds // 86400
        return f"{d}-day"
    if seconds % 3600 == 0:
        h = seconds // 3600
        return f"{h}-hour"
    return f"{seconds}s"


# ------------------------------------------------------------------ row ----

LABEL_GAP_W = 2
BAR_GAP_W = 1
OVERFLOW_W = 2


def min_bar_width(width: int) -> int:
    return 4 if width < 46 else 8


def window_elapsed_pct(window_seconds: float | None,
                       remaining_seconds: float | None) -> float | None:
    """Percent of a limit window already elapsed, clamped to 0-100."""
    if not window_seconds or remaining_seconds is None:
        return None
    return max(0.0, min(
        100.0, (window_seconds - remaining_seconds) / window_seconds * 100))


def pace_verdict(usage_pct: float, now_pct: float | None) -> str | None:
    """'over', 'under', or 'on' pace (±5pp of elapsed window), else None."""
    if now_pct is None:
        return None
    if usage_pct >= now_pct + 5:
        return "over"
    if usage_pct <= now_pct - 5:
        return "under"
    return "on"


def usage_row(label: str, utilization: float, window_seconds: float | None,
              reset_seconds: float | None) -> dict:
    """A view row: one limit window with its severity and pace verdict."""
    now_pct = window_elapsed_pct(window_seconds, reset_seconds)
    return {
        "type": "row",
        "label": label,
        "utilization": utilization,
        "severity": severity_tone(utilization),
        "window_seconds": window_seconds,
        "reset_seconds": reset_seconds,
        "now_pct": now_pct,
        "pace": pace_verdict(utilization, now_pct),
    }


def row_layout_widths(rows: list[dict], width: int) -> tuple[int, int]:
    """Shared (label, percent) column widths for a section's view rows."""
    pct_w = max((len(f"{r['utilization']:.0f}%") for r in rows), default=3)
    max_label_w = max(
        1,
        width - LABEL_GAP_W - pct_w - BAR_GAP_W - OVERFLOW_W
        - min_bar_width(width),
    )
    return min(max((len(r["label"]) for r in rows), default=1),
               max_label_w), pct_w


PACE_STYLES = {
    "over": (TONES["critical"], "↑", "over pace"),
    "under": (TONES["good"], "↓", "under pace"),
    "on": (WHITE, None, "on pace"),
}


def row(r: dict, width: int, label_w: int, pct_w: int) -> str:
    label, usage_pct = r["label"], r["utilization"]
    now_pct, reset_seconds = r["now_pct"], r["reset_seconds"]
    raw_label = fit_text(label, label_w)
    label_col_w = label_w + LABEL_GAP_W
    pct_text = f"{usage_pct:.0f}%"
    pct_col_w = max(pct_w, len(pct_text))
    pct_str = f"{pct_text:>{pct_col_w}}"
    bar_w = max(min_bar_width(width),
                width - label_col_w - pct_col_w - BAR_GAP_W - OVERFLOW_W)
    bar, overflow = render_bar(bar_w, usage_pct)
    lbl = f"{BOLD}{raw_label:<{label_w}}{RESET}{' ' * LABEL_GAP_W}"
    pct_color = color_for_pct(usage_pct)
    overflow_mark = f" {fg256(203)}↑{RESET}" if overflow else "  "
    line1 = f"{lbl}{pct_color}{pct_str}{RESET} {bar}{overflow_mark}"
    bar_start = label_col_w + pct_col_w + BAR_GAP_W

    line0 = ""
    countdown_text = (
        f"in {fmt_relative(reset_seconds)}"
        if reset_seconds is not None else None
    )
    if now_pct is not None:
        margin = usage_pct - now_pct
        pace_color, arrow, verdict = PACE_STYLES[r["pace"]]
        if arrow is None:
            pace_text = "≈ on pace"
        elif width < 64:
            pace_text = f"{arrow} {margin:+.0f}pp"
        else:
            pace_text = f"{arrow} {margin:+.0f}pp {verdict}"
        now_idx = min(max(0, round(now_pct / 100 * bar_w)), bar_w - 1)
        marker_col = bar_start + now_idx
        now_label = f"{now_pct:.0f}%"
        marker_pad = "  "
        segment_sep = " · "

        def joined_len(segments: list[tuple[str, str]]) -> int:
            return (sum(len(text) for text, _color in segments)
                    + len(segment_sep) * (len(segments) - 1))

        # Each segment goes right of the marker when it fits, else left.
        left_segments: list[tuple[str, str]] = []
        right_segments: list[tuple[str, str]] = []
        right_capacity = width - marker_col - len(NOW_MARK)
        for segment in [(pace_text, pace_color), (countdown_text, SUB_FG)]:
            if not segment[0]:
                continue
            candidate = right_segments + [segment]
            if len(marker_pad) + joined_len(candidate) <= right_capacity:
                right_segments = candidate
                continue
            candidate = left_segments + [segment]
            if (len(now_label) + 1 + joined_len(candidate)
                    + len(marker_pad)) <= marker_col:
                left_segments = candidate

        def colored_segments(segments: list[tuple[str, str]]) -> str:
            return (SUB_FG + segment_sep + RESET).join(
                color + text + RESET for text, color in segments)

        left = pace_color + now_label + RESET
        if left_segments:
            left += " " + colored_segments(left_segments)
        left += marker_pad
        right = ""
        if right_segments:
            right = marker_pad + colored_segments(right_segments)
        marker_start = marker_col - visible_len(left)
        line0 = (
            " " * marker_start
            + left
            + pace_color + NOW_MARK + RESET
            + right
        )
    elif countdown_text:
        line0 = " " * bar_start + SUB_FG + countdown_text + RESET

    return "\n".join([
        clip_ansi(line0, width),
        clip_ansi(line1, width),
    ])


# -------------------------------------------------------------- header ----

def section_header(title: str, plan: str, width: int,
                   notices: list[str | None] | None = None) -> list[str]:
    left_parts = [f"{BOLD}{title}{RESET}"]
    if plan and width >= 48:
        left_parts.append(f"{DIM}{plan}{RESET}")
    notice_parts = [n for n in (notices or []) if n]
    now_str = fmt_local(datetime.now(timezone.utc))
    if width < 48:
        left_parts.extend(notice_parts)
        left = "  ".join(left_parts)
        line = left
    else:
        max_left = max(0, width - len(now_str) - 1)
        left = "  ".join(left_parts)
        for notice in notice_parts:
            candidate = f"{left}  {notice}"
            if visible_len(candidate) <= max_left:
                left = candidate
        pad = width - visible_len(left) - len(now_str)
        if pad < 1:
            left = clip_ansi(left, max(0, width - len(now_str) - 1))
            pad = width - visible_len(left) - len(now_str)
        if pad < 1:
            line = left
        else:
            line = left + " " * pad + DIM + now_str + RESET
    return [clip_ansi(line, width), RULE_FG + "─" * width + RESET]


def warn_line(msg: str) -> str:
    return f"  {fg256(203)}✖ {msg}{RESET}"


def rate_limit_notice(age: float | None) -> dict:
    """Report a 429 backoff. age=None means we hit it live this render."""
    remaining = max(0.0, rate_limit_ttl() - (age or 0.0))
    return seg("● rate limited (429), retry in ", "warn", remaining)


def token_expiry_notice(expires_at_ms: int | None
                        ) -> tuple[dict | None, bool]:
    """Return an OAuth-expiry header notice and whether it is expired."""
    if expires_at_ms is None:
        return None, False
    exp = datetime.fromtimestamp(expires_at_ms / 1000, tz=timezone.utc)
    secs = (exp - datetime.now(timezone.utc)).total_seconds()
    if secs <= 0:
        return seg("✖ OAuth expired ", "critical", -secs, "up", " ago"), True
    if secs > 4 * 3600:
        return None, False
    tone = "critical" if secs < 3600 else "warn"
    return seg("⚠ OAuth expires in ", tone, secs), False


