def adjusted_openai_reset_seconds(snapshot: dict, window: dict
                                  ) -> float | None:
    reset_at = window.get("reset_at")
    if reset_at:
        reset_dt = datetime.fromtimestamp(reset_at, tz=timezone.utc)
        return max(0.0, (reset_dt - datetime.now(timezone.utc)).total_seconds())
    rem_s = window.get("reset_after_seconds")
    if rem_s is None:
        return None
    cache_age = float(snapshot.get("age") or 0.0)
    return max(0.0, float(rem_s) - cache_age - snapshot_elapsed(snapshot))


def openai_window_rows(snapshot: dict, rate_limit: dict
                       ) -> list[tuple[str, float, float | None,
                                       datetime | None, float | None]]:
    """Normalize an OpenAI rate-limit object into dashboard rows."""
    rows = []
    for key, default_label in [
        ("secondary_window", "secondary"),
        ("primary_window", "primary"),
    ]:
        window = rate_limit.get(key)
        if not window:
            continue
        usage = float(window.get("used_percent", 0))
        window_s = window.get("limit_window_seconds")
        remaining_s = adjusted_openai_reset_seconds(snapshot, window)
        if window_s and remaining_s is not None:
            now_pct = max(0.0, min(
                100.0,
                (window_s - remaining_s) / window_s * 100,
            ))
        else:
            now_pct = None
        reset_at = window.get("reset_at")
        reset_dt = (datetime.fromtimestamp(reset_at, tz=timezone.utc)
                    if reset_at else None)
        label = fmt_window(window_s) if window_s else default_label
        if key == "secondary_window":
            label = f"{label} (weekly)"
        rows.append((label, usage, now_pct, reset_dt, remaining_s))
    return rows


def openai_reset_credit_count(body: dict) -> int:
    """Available reset-credit count from the usage endpoint.

    Newer Codex app-server RPCs can also return per-credit detail rows, but the
    direct /wham/usage endpoint used here guarantees only the aggregate count.
    Accept a detail list when present so cached/newer shapes remain compatible.
    """
    reset_credits = body.get("rate_limit_reset_credits") or {}
    count = reset_credits.get("available_count")
    if isinstance(count, (int, float)) and not isinstance(count, bool):
        return max(0, int(count))
    credits = reset_credits.get("credits")
    if isinstance(credits, list):
        return sum(
            1 for credit in credits
            if not isinstance(credit, dict)
            or credit.get("status") in (None, "available")
        )
    return 0


def openai_reset_credit_details_complete(body: dict) -> bool:
    """Whether detail rows cover every available reset credit."""
    reset_credits = body.get("rate_limit_reset_credits") or {}
    credits = reset_credits.get("credits")
    if not isinstance(credits, list):
        return False
    available = [
        credit for credit in credits
        if isinstance(credit, dict)
        and credit.get("status") in (None, "available")
    ]
    return len(available) == openai_reset_credit_count(body)


def openai_next_reset_credit_expiry(
        body: dict, require_future: bool = True) -> float | None:
    """Return the earliest expiry only when all available rows are complete."""
    if not openai_reset_credit_details_complete(body):
        return None
    reset_credits = body.get("rate_limit_reset_credits") or {}
    available = [
        credit for credit in reset_credits.get("credits") or []
        if isinstance(credit, dict)
        and credit.get("status") in (None, "available")
    ]
    if not available:
        return None
    expiries = [credit.get("expires_at") for credit in available]
    if any(not isinstance(value, (int, float)) or isinstance(value, bool)
           for value in expiries):
        return None
    expiry = float(min(expiries))
    if require_future and expiry <= time.time():
        return None
    return expiry


def fmt_reset_credit_expiry(expires_at: float) -> str:
    dt = datetime.fromtimestamp(expires_at, tz=timezone.utc).astimezone()
    return dt.strftime("%a %b %d %H:%M %Z")


def openai_credit_status_line(body: dict) -> str | None:
    """Compact, read-only status for purchased and usage-reset credits."""
    parts = []
    credits = body.get("credits") or {}
    if credits.get("unlimited"):
        parts.append(f"{fg256(78)}credits unlimited{RESET}")
    elif credits.get("overage_limit_reached"):
        parts.append(f"{fg256(203)}credit limit reached{RESET}")
    elif credits.get("has_credits"):
        balance = credits.get("balance")
        text = (f"credit balance {balance}"
                if balance not in (None, "") else "credits available")
        parts.append(f"{fg256(78)}{text}{RESET}")

    reset_count = openai_reset_credit_count(body)
    if reset_count:
        noun = "reset" if reset_count == 1 else "resets"
        reset_text = f"{fg256(78)}{reset_count} usage {noun}{RESET}"
        next_expiry = openai_next_reset_credit_expiry(body)
        if next_expiry is not None:
            remaining = next_expiry - time.time()
            if remaining <= 4 * 3600:
                expiry_color = fg256(203)
            elif remaining <= 24 * 3600:
                expiry_color = fg256(214)
            elif remaining <= 3 * 86400:
                expiry_color = fg256(186)
            else:
                expiry_color = SUB_FG
            if remaining <= 3 * 86400:
                when = (
                    f"in {fmt_relative(remaining)} "
                    f"({fmt_reset_credit_expiry(next_expiry)})"
                )
            else:
                when = fmt_reset_credit_expiry(next_expiry)
            reset_text += (
                f"{SUB_FG}, {RESET}{expiry_color}next expires {when}{RESET}"
            )
        parts.append(reset_text)
    if not parts:
        return None
    return f"  {DIM}Extras:{RESET} " + (SUB_FG + " · " + RESET).join(parts)


def openai_additional_rate_limits(body: dict
                                  ) -> list[tuple[str, dict, str | None]]:
    """Return named model/feature-specific rate-limit groups."""
    groups = []
    for item in body.get("additional_rate_limits") or []:
        if not isinstance(item, dict):
            continue
        rate_limit = item.get("rate_limit")
        if not isinstance(rate_limit, dict):
            continue
        feature = item.get("metered_feature")
        title = item.get("limit_name") or feature or "Additional limit"
        groups.append((str(title), rate_limit,
                       str(feature) if feature is not None else None))
    return groups


def is_codex_spark_limit(title: str, feature: str | None) -> bool:
    """Whether an additional rate-limit group is the Codex Spark quota."""
    normalized_title = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
    return feature == "codex_bengalfox" or "codex-spark" in normalized_title


def openai_limit_heading(title: str, rate_limit: dict) -> str:
    status = ""
    if rate_limit.get("limit_reached"):
        status = f"  {fg256(203)}● limit reached{RESET}"
    elif not rate_limit.get("allowed", True):
        status = f"  {fg256(214)}⚠ not currently allowed{RESET}"
    return f"  {DIM}{title}{RESET}{status}"


def render_openai_section(snapshot: dict, width: int,
                          suppress_codex_spark: bool = False
                          ) -> tuple[list[str], bool]:
    """Render the OpenAI section. Returns lines plus success state."""
    lines = []
    tok = snapshot.get("token")
    if not tok or not tok.get("access_token"):
        lines.extend(section_header("OPENAI", "ChatGPT", width))
        service_line = provider_status_line(snapshot.get("service_status"))
        if service_line:
            lines.append(service_line)
        lines.append(warn_line("no OAuth token "
                               "(set $CODEX_OAUTH_TOKEN or run `codex` "
                               "to login)"))
        return [clip_ansi(line, width) for line in lines], False

    code = snapshot.get("code")
    body = snapshot.get("body") or {}
    plan = (body.get("plan_type") or "").title() if code == 200 else ""
    expiry, expired = token_expiry_notice(tok.get("expires_at_ms"))
    if code == 429:
        status = rate_limit_notice(
            displayed_cache_age(snapshot, include_live_429=True))
    else:
        status = cache_notice(code, displayed_cache_age(snapshot))
    lines.extend(section_header(
        "OPENAI",
        f"ChatGPT {plan} Plan" if plan else "ChatGPT",
        width,
        [status, expiry],
    ))
    service_line = provider_status_line(snapshot.get("service_status"))
    if service_line:
        lines.append(service_line)

    if code == 401:
        lines.append(warn_line("token rejected (401)"
                               + (" — expired" if expired else "")
                               + "; run `codex` to refresh"))
        return [clip_ansi(line, width) for line in lines], False
    if code == 429:
        return [clip_ansi(line, width) for line in lines], False
    if code != 200:
        lines.append(warn_line(f"API error {code}: {json.dumps(body)[:200]}"))
        return [clip_ansi(line, width) for line in lines], False

    credit_line = openai_credit_status_line(body)
    if credit_line:
        lines.append(credit_line)

    rl = body.get("rate_limit") or {}
    if rl.get("limit_reached"):
        lines.append(f"  {fg256(203)}● limit reached — requests will be rejected"
                     f"{RESET}")
    elif not rl.get("allowed", True):
        lines.append(f"  {fg256(214)}⚠ requests not currently allowed{RESET}")

    # Weekly (secondary) window first — it's the limit that matters most.
    base_rows = openai_window_rows(snapshot, rl)
    additional_groups = [
        (title, rate_limit, openai_window_rows(snapshot, rate_limit))
        for title, rate_limit, feature in openai_additional_rate_limits(body)
        if not suppress_codex_spark
        or not is_codex_spark_limit(title, feature)
    ]
    window_rows = base_rows + [
        window_row
        for _title, _rate_limit, group_rows in additional_groups
        for window_row in group_rows
    ]

    label_w, pct_w = row_layout_widths(
        [label for label, _usage, _now_pct, _reset_dt, _rem_s in window_rows],
        [usage for _label, usage, _now_pct, _reset_dt, _rem_s in window_rows],
        width,
    )
    printed = 0
    for label, usage, now_pct, reset_dt, rem_s in base_rows:
        lines.extend(row(label, usage, now_pct, reset_dt, rem_s, width,
                         label_w, pct_w).splitlines())
        printed += 1
    for title, rate_limit, group_rows in additional_groups:
        if not group_rows:
            continue
        lines.append(openai_limit_heading(title, rate_limit))
        for label, usage, now_pct, reset_dt, rem_s in group_rows:
            lines.extend(row(label, usage, now_pct, reset_dt, rem_s, width,
                             label_w, pct_w).splitlines())
            printed += 1
    if not printed:
        lines.append(f"  {DIM}(no usage data){RESET}")
    return [clip_ansi(line, width) for line in lines], True


# ------------------------------------------------------------ json output ----
#
# `--json` emits a machine-readable snapshot for schedulers (e.g. bin/checkpoint)
# that route work to whichever subscription has the most headroom. Both providers
# are normalized to a uniform shape: each relevant window reports `utilization`
# as a percent (0-100) plus seconds-until-reset. Each provider also includes
# its provider-specific additional limits and read-only credit/spend status.

def _anthropic_json(service_status_snapshot: dict | None = None) -> dict:
    if service_status_snapshot is None:
        service_status_snapshot = provider_status_snapshot("anthropic")
    service_status = provider_status_json(service_status_snapshot)
    tok = load_anthropic_token()
    if not tok or not tok.get("access_token"):
        return {"ok": False, "error": "no OAuth token", "windows": {},
                "cached": False, "cache_age_seconds": None,
                "service_status": service_status}
    code, a, age = cached_fetch("anthropic", fetch_anthropic, tok)
    if code != 200:
        err = "rate limited (429)" if code == 429 else f"API error {code}"
        return {"ok": False, "error": err, "windows": {},
                "rate_limited": code == 429,
                "oauth_expires_at_ms": tok.get("expires_at_ms"),
                "cached": age is not None, "cache_age_seconds": age,
                "service_status": service_status}
    now = datetime.now(timezone.utc)
    windows: dict[str, Any] = {}
    for band in anthropic_limit_bands(a):
        reset_dt = parse_iso(band.get("resets_at"))
        rem = (reset_dt - now).total_seconds() if reset_dt else None
        windows[band["key"]] = {
            "label": band["label"],
            "utilization": band["utilization"],
            "resets_at": band.get("resets_at"),
            "reset_seconds": rem,
            "window_seconds": band["window_seconds"],
            "kind": band.get("kind"),
            "group": band.get("group"),
            "is_active": band.get("is_active"),
            "severity": band.get("severity"),
            "source": band.get("source"),
        }
    return {"ok": True, "error": None,
            "subscription": tok.get("subscription"), "windows": windows,
            "usage_credits": normalize_anthropic_spend(a),
            "oauth_expires_at_ms": tok.get("expires_at_ms"),
            "cached": age is not None, "cache_age_seconds": age,
            "service_status": service_status}


def _openai_json(service_status_snapshot: dict | None = None) -> dict:
    if service_status_snapshot is None:
        service_status_snapshot = provider_status_snapshot("openai")
    service_status = provider_status_json(service_status_snapshot)
    loaded_at = time.time()
    tok = load_codex_token()
    if not tok or not tok.get("access_token"):
        return {"ok": False, "error": "no OAuth token", "windows": {},
                "cached": False, "cache_age_seconds": None,
                "service_status": service_status}
    code, o, age = cached_fetch("openai", fetch_codex, tok)
    if code != 200:
        err = "rate limited (429)" if code == 429 else f"API error {code}"
        return {"ok": False, "error": err, "windows": {},
                "rate_limited": code == 429,
                "oauth_expires_at_ms": tok.get("expires_at_ms"),
                "cached": age is not None, "cache_age_seconds": age,
                "service_status": service_status}
    rl = o.get("rate_limit") or {}
    snapshot = {"loaded_at": loaded_at, "age": age}
    windows: dict[str, Any] = {}
    for key in ("secondary_window", "primary_window"):
        w = rl.get(key)
        if not w:
            continue
        windows[key] = {
            "utilization": float(w.get("used_percent", 0)),
            "reset_seconds": adjusted_openai_reset_seconds(snapshot, w),
            "reset_at": w.get("reset_at"),
            "window_seconds": w.get("limit_window_seconds"),
        }
    additional = []
    for title, rate_limit, feature in openai_additional_rate_limits(o):
        extra_windows: dict[str, Any] = {}
        for key in ("secondary_window", "primary_window"):
            w = rate_limit.get(key)
            if not w:
                continue
            extra_windows[key] = {
                "utilization": float(w.get("used_percent", 0)),
                "reset_seconds": adjusted_openai_reset_seconds(snapshot, w),
                "reset_at": w.get("reset_at"),
                "window_seconds": w.get("limit_window_seconds"),
            }
        additional.append({
            "name": title,
            "metered_feature": feature,
            "allowed": bool(rate_limit.get("allowed", True)),
            "limit_reached": bool(rate_limit.get("limit_reached")),
            "windows": extra_windows,
        })
    credits = o.get("credits") or {}
    next_credit_expiry = openai_next_reset_credit_expiry(o)
    reset_credit_json: dict[str, Any] = {
        "available_count": openai_reset_credit_count(o),
        "details_complete": openai_reset_credit_details_complete(o),
        "next_expires_at": next_credit_expiry,
        "next_expires_in_seconds": (
            max(0.0, next_credit_expiry - time.time())
            if next_credit_expiry is not None else None
        ),
    }
    return {"ok": True, "error": None,
            "plan": o.get("plan_type"),
            "oauth_expires_at_ms": tok.get("expires_at_ms"),
            "limit_reached": bool(rl.get("limit_reached")),
            "windows": windows,
            "additional_rate_limits": additional,
            "credits": {
                "has_credits": bool(credits.get("has_credits")),
                "unlimited": bool(credits.get("unlimited")),
                "balance": credits.get("balance"),
                "overage_limit_reached": bool(
                    credits.get("overage_limit_reached")),
            },
            "rate_limit_reset_credits": reset_credit_json,
            "cached": age is not None, "cache_age_seconds": age,
            "service_status": service_status}


def emit_json() -> int:
    a = _anthropic_json()
    o = _openai_json()
    print(json.dumps({"anthropic": a, "openai": o}, indent=2))
    return 0 if (a["ok"] and o["ok"]) else (1 if (a["ok"] or o["ok"]) else 2)


# ------------------------------------------------------------ html output ----
#
# `--html` serves a display-only browser dashboard from a loopback HTTP server
# and opens it in the preferred browser; the page re-renders locally every
# second (countdowns, pace tick) and polls /data.json every minute, which runs
# `llm-usage --json` as a subprocess — so the HTML surface consumes exactly the
# same cache-aware source of truth as every other consumer, and the endpoints
# are still hit at most once per TTL window. `--html-static <path>` writes one
# self-contained snapshot page (payload embedded, polling disabled) so an agent
# can open it or screenshot it. Both are read-only surfaces with no controls.
#
# Visual language: each window row is the CLI's pace instrument translated —
# a status-colored usage fill, a "now" tick at percent-of-window-elapsed, and
# the interval between them painted as headroom (green) or overrun (red).
# Colors follow the system light/dark mode via prefers-color-scheme.

