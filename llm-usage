def adjusted_openai_reset_seconds(snapshot: dict, window: dict
                                  ) -> float | None:
    reset_at = window.get("reset_at")
    if reset_at:
        reset_dt = datetime.fromtimestamp(reset_at, tz=timezone.utc)
        return max(0.0, (reset_dt - datetime.now(timezone.utc)).total_seconds())
    rem_s = window.get("reset_after_seconds")
    if rem_s is None:
        return None
    cache_age = float(snapshot.get("age") or 0.0)
    return max(0.0, float(rem_s) - cache_age - snapshot_elapsed(snapshot))


def openai_bands(snapshot: dict, rate_limit: dict) -> list[dict]:
    """Normalize an OpenAI rate-limit object's windows, weekly first."""
    bands = []
    for key, default_label in [
        ("secondary_window", "secondary"),
        ("primary_window", "primary"),
    ]:
        window = rate_limit.get(key)
        if not window:
            continue
        window_s = window.get("limit_window_seconds")
        label = fmt_window(window_s) if window_s else default_label
        if key == "secondary_window":
            label = f"{label} (weekly)"
        bands.append({
            "key": key,
            "label": label,
            "utilization": float(window.get("used_percent", 0)),
            "reset_seconds": adjusted_openai_reset_seconds(snapshot, window),
            "reset_at": window.get("reset_at"),
            "window_seconds": window_s,
        })
    return bands


def openai_reset_credit_count(body: dict) -> int:
    """Available reset-credit count from the usage endpoint.

    Newer Codex app-server RPCs can also return per-credit detail rows, but the
    direct /wham/usage endpoint used here guarantees only the aggregate count.
    Accept a detail list when present so cached/newer shapes remain compatible.
    """
    reset_credits = body.get("rate_limit_reset_credits") or {}
    count = reset_credits.get("available_count")
    if isinstance(count, (int, float)) and not isinstance(count, bool):
        return max(0, int(count))
    credits = reset_credits.get("credits")
    if isinstance(credits, list):
        return sum(
            1 for credit in credits
            if not isinstance(credit, dict)
            or credit.get("status") in (None, "available")
        )
    return 0


def _available_reset_credit_rows(body: dict) -> list[dict] | None:
    """Available per-credit detail rows, or None when no detail list exists."""
    credits = (body.get("rate_limit_reset_credits") or {}).get("credits")
    if not isinstance(credits, list):
        return None
    return [
        credit for credit in credits
        if isinstance(credit, dict)
        and credit.get("status") in (None, "available")
    ]


def openai_reset_credit_details_complete(body: dict) -> bool:
    """Whether detail rows cover every available reset credit."""
    available = _available_reset_credit_rows(body)
    return (available is not None
            and len(available) == openai_reset_credit_count(body))


def openai_next_reset_credit_expiry(
        body: dict, require_future: bool = True) -> float | None:
    """Return the earliest expiry only when all available rows are complete."""
    available = _available_reset_credit_rows(body)
    if not available or len(available) != openai_reset_credit_count(body):
        return None
    expiries = [credit.get("expires_at") for credit in available]
    if any(not isinstance(value, (int, float)) or isinstance(value, bool)
           for value in expiries):
        return None
    expiry = float(min(expiries))
    if require_future and expiry <= time.time():
        return None
    return expiry


def fmt_reset_credit_expiry(expires_at: float) -> str:
    return fmt_local(datetime.fromtimestamp(expires_at, tz=timezone.utc))


def reset_credit_part(count: int, next_expiry: float | None) -> list[dict]:
    """'N usage resets' plus an urgency-toned next-expiry clause."""
    noun = "reset" if count == 1 else "resets"
    part = [seg(f"{count} usage {noun}", "good")]
    if next_expiry is None:
        return part
    remaining = next_expiry - time.time()
    if remaining <= 4 * 3600:
        tone = "critical"
    elif remaining <= 24 * 3600:
        tone = "warn"
    elif remaining <= 3 * 86400:
        tone = "caution"
    else:
        tone = "sub"
    when = fmt_reset_credit_expiry(next_expiry)
    if remaining <= 3 * 86400:
        expiry = seg("next expires in ", tone, remaining, after=f" ({when})")
    else:
        expiry = seg(f"next expires {when}", tone)
    return part + [seg(", ", "sub"), expiry]


def openai_extras_parts(body: dict) -> list[list[dict]]:
    """Compact, read-only status for purchased and usage-reset credits."""
    parts = []
    credits = body.get("credits") or {}
    if credits.get("unlimited"):
        parts.append([seg("credits unlimited", "good")])
    elif credits.get("overage_limit_reached"):
        parts.append([seg("credit limit reached", "critical")])
    elif credits.get("has_credits"):
        balance = credits.get("balance")
        text = (f"credit balance {balance}"
                if balance not in (None, "") else "credits available")
        parts.append([seg(text, "good")])

    reset_count = openai_reset_credit_count(body)
    if reset_count:
        parts.append(reset_credit_part(
            reset_count, openai_next_reset_credit_expiry(body)))
    return parts


def openai_credit_status_line(body: dict) -> str | None:
    return extras_line(openai_extras_parts(body))


def openai_additional_rate_limits(body: dict) -> list[dict]:
    """Return named model/feature-specific rate-limit groups.

    Each group carries the raw `name` (limit_name or metered feature), the
    user-facing `display_name` from `openai_limit_display_name`, the metered
    feature, the reserve model slug, and the raw `rate_limit` object.
    """
    groups = []
    for item in body.get("additional_rate_limits") or []:
        if not isinstance(item, dict):
            continue
        rate_limit = item.get("rate_limit")
        if not isinstance(rate_limit, dict):
            continue
        feature = item.get("metered_feature")
        feature_str = str(feature) if feature is not None else None
        name = item.get("limit_name") or feature_str or "Additional limit"
        model_slug = item.get("normal_model_slug")
        groups.append({
            "name": name,
            "display_name": openai_limit_display_name(
                str(name), feature_str, model_slug),
            "metered_feature": feature_str,
            "normal_model_slug": model_slug,
            "rate_limit": rate_limit,
        })
    return groups


def openai_limit_display_name(title: str, feature: str | None,
                              model_slug: str | None = None) -> str:
    """Friendly label for an additional rate-limit group.

    OpenAI reports these with internal identifiers: the Codex Spark research
    preview arrives as `GPT-5.3-Codex-Spark` / `codex_bengalfox`, and the
    Luna Reserve fallback allowance arrives as `gpt-reserve` with the reserve
    model in `normal_model_slug` (e.g. `gpt-5.6-luna`). Anything unrecognized
    keeps its reported name.
    """
    slug = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
    if feature == "codex_bengalfox" or "codex-spark" in slug:
        return "Codex Spark"
    if slug == "gpt-reserve" or slug.endswith("-reserve"):
        model = re.sub(r"[^a-z0-9]+", "-", str(model_slug or "").lower())
        tail = model.strip("-").rsplit("-", 1)[-1]
        if tail and not re.fullmatch(r"[0-9.]+|gpt", tail):
            return f"{tail.title()} Reserve"
        return "GPT Reserve"
    return title


def openai_limit_in_use(rate_limit: dict) -> bool:
    """Whether any window of an additional rate-limit group shows usage.

    Spark and Luna Reserve allowances sit at 0% unless the user opts into
    them, so an untouched group is noise on the dashboard and stays hidden.
    """
    for key in ("primary_window", "secondary_window"):
        window = rate_limit.get(key)
        if not isinstance(window, dict):
            continue
        try:
            if float(window.get("used_percent") or 0) > 0:
                return True
        except (TypeError, ValueError):
            continue
    return False


def openai_limit_badges(rate_limit: dict) -> list[dict]:
    if rate_limit.get("limit_reached"):
        return [seg("● limit reached", "critical")]
    if not rate_limit.get("allowed", True):
        return [seg("⚠ not currently allowed", "warn")]
    return []


