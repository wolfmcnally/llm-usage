<script id="payload" type="application/json">__PAYLOAD_JSON__</script>
<script>
"use strict";
const MODE = document.body.dataset.mode;
const POLL_MS = __POLL_SECONDS__ * 1000;
let data = JSON.parse(document.getElementById("payload").textContent);
let receivedAt = Date.now();
let offline = false;

function elapsed() { return (Date.now() - receivedAt) / 1000; }

function fmtRel(s) {
  s = Math.max(0, Math.floor(s));
  const d = Math.floor(s / 86400);
  const h = Math.floor((s % 86400) / 3600);
  const m = Math.floor((s % 3600) / 60);
  if (d) return d + "d " + h + "h";
  if (h) return h + "h " + String(m).padStart(2, "0") + "m";
  return m + "m";
}

function fmtAgo(s) { return s < 60 ? Math.floor(s) + "s" : fmtRel(s); }

function h(tag, cls, ...kids) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  for (const k of kids) {
    if (k === null || k === undefined) continue;
    e.appendChild(typeof k === "string" ? document.createTextNode(k) : k);
  }
  return e;
}

// Every display decision arrives precomputed in each provider's `display`
// block (see provider_view); this page only maps tones to classes, lays the
// block out, and keeps embedded clocks ticking between polls.
function segText(s) {
  if (typeof s.seconds !== "number") return s.text;
  const t = s.counting === "up" ? s.seconds + elapsed() : s.seconds - elapsed();
  return s.text + fmtRel(t) + s.after;
}

function segEl(s) { return h("span", "t-" + s.tone, segText(s)); }

function partEl(part) { return h("span", null, ...part.map(segEl)); }

function metaSegs(...segs) {
  const out = [];
  for (const seg of segs) {
    if (!seg) continue;
    if (out.length) out.push(h("span", null, "\\u00b7"));
    out.push(seg);
  }
  return out;
}

const FILL = {good: "g", caution: "w", warn: "s", critical: "c"};
const PACE = {over: ["pace-over", "\\u2191", " over pace"],
              under: ["pace-under", "\\u2193", " under pace"],
              on: ["pace-on", null, null]};

function rowEl(it) {
  const util = Math.max(0, Number(it.utilization) || 0);
  const rem = typeof it.reset_seconds === "number"
    ? Math.max(0, it.reset_seconds - elapsed()) : null;
  const nowPct = typeof it.now_pct === "number" ? it.now_pct : null;
  const fillPct = Math.min(util, 100);

  const clip = h("div", "track-clip");
  const fill = h("div", "fill " + (FILL[it.severity] || "g"));
  fill.style.width = fillPct + "%";
  clip.appendChild(fill);

  let paceCls = "pace-on";
  let paceSeg = null;
  let nowSeg = null;
  if (nowPct !== null && PACE[it.pace]) {
    const [cls, arrow, verdict] = PACE[it.pace];
    paceCls = cls;
    const margin = util - nowPct;
    const signed = (margin >= 0 ? "+" : "\\u2212") +
      Math.abs(margin).toFixed(0) + "pp";
    paceSeg = h("span", cls,
      arrow ? arrow + " " + signed + verdict : "\\u2248 on pace");
    if (it.pace === "over") {
      const left = Math.min(nowPct, fillPct);
      const band = h("div", "band deficit");
      band.style.left = left + "%";
      band.style.width = (fillPct - left) + "%";
      clip.appendChild(band);
    } else if (it.pace === "under") {
      const band = h("div", "band lead");
      band.style.left = fillPct + "%";
      band.style.width = (nowPct - fillPct) + "%";
      clip.appendChild(band);
    }
    nowSeg = h("span", null, "now " + nowPct.toFixed(0) + "%");
  }

  const track = h("div", "track", clip);
  if (nowPct !== null) {
    const tick = h("div", "tick " + paceCls);
    tick.style.left = nowPct + "%";
    track.appendChild(tick);
  }

  const utilEl = h("span", "util", util.toFixed(0) + "%");
  if (util > 100) utilEl.appendChild(h("span", "ovf", "\\u2191"));
  const resetSeg = rem !== null
    ? h("span", null, "resets in " + fmtRel(rem)) : null;
  return h("div", "rowline",
    h("div", "row-head",
      h("span", "row-label", it.label),
      h("span", "row-meta", ...metaSegs(nowSeg, paceSeg, resetSeg))),
    h("div", "row-body", utilEl, track));
}

function serviceEl(s) {
  if (!s) return null;
  const line = h("div", "svc", segEl(s));
  if (s.link) {
    const a = h("a", null, "\\u2197");
    a.href = s.link;
    a.target = "_blank";
    a.rel = "noopener";
    a.title = "Open status page";
    a.setAttribute("aria-label", "Open status page");
    line.appendChild(a);
  }
  return line;
}

function card(name, p) {
  // A payload without a view (collection failed) still renders its error.
  const d = p.display || {title: name, plan: "", notices: [], service: null,
    error: p.error || "unavailable", alerts: [], extras: [], rows: []};
  const nameEl = h("div", null, h("span", "p-name", d.title));
  if (d.plan) nameEl.appendChild(h("span", "p-plan", d.plan));
  const c = h("section", "card",
    h("div", "card-head", nameEl,
      h("div", "head-notes", ...d.notices.map(segEl))));
  const svc = serviceEl(d.service);
  if (svc) c.appendChild(svc);
  if (d.error) c.appendChild(h("div", "err", "\\u2716 " + d.error));
  if (!p.ok) return c;
  for (const a of d.alerts) c.appendChild(h("div", "alert", segEl(a)));
  let printed = 0;
  for (const it of d.rows) {
    if (it.type === "heading") {
      c.appendChild(h("div", "group",
        h("span", null, it.text), ...it.badges.map(segEl)));
    } else {
      c.appendChild(rowEl(it));
      printed++;
    }
  }
  if (!printed) c.appendChild(h("div", "empty", "(no usage data)"));
  if (d.extras.length) {
    c.appendChild(h("div", "extras", h("span", "x-label", "extras"),
      ...metaSegs(...d.extras.map(partEl))));
  }
  return c;
}

function chipEl() {
  const el = document.getElementById("mode-chip");
  el.classList.toggle("offline", offline);
  if (MODE === "static") {
    const when = typeof data.generated_at === "number"
      ? new Date(data.generated_at * 1000).toLocaleString() : "";
    el.textContent = "static snapshot" + (when ? " \\u00b7 " + when : "");
  } else if (offline) {
    el.textContent = "\\u25cf source offline \\u00b7 data "
      + fmtAgo(elapsed()) + " old";
  } else {
    el.textContent = "live \\u00b7 updated " + fmtAgo(elapsed()) + " ago";
  }
}

function render() {
  const missing = {ok: false, error: "missing provider data"};
  const root = document.getElementById("providers");
  root.textContent = "";
  root.appendChild(card("ANTHROPIC", data.anthropic || missing));
  root.appendChild(card("OPENAI", data.openai || missing));
  chipEl();
}

if (MODE === "live") {
  setInterval(async () => {
    try {
      const response = await fetch("data.json", {cache: "no-store"});
      if (!response.ok) throw new Error("HTTP " + response.status);
      data = await response.json();
      receivedAt = Date.now();
      offline = false;
    } catch (e) {
      offline = true;
    }
    render();
  }, POLL_MS);
}
setInterval(render, 1000);
render();
</script>
</body>
</html>
"""


def usage_payload(fresh: bool = False) -> dict:
    """Collect the `--json` snapshot by invoking this executable.

    Running the CLI as a subprocess keeps the HTML surface on exactly the same
    source of truth as every other `--json` consumer, including its cache and
    backoff behavior, so a polling page can never hit the provider endpoints
    more often than the CLI itself would.
    """
    cmd = [sys.executable, os.path.realpath(__file__), "--json"]
    if fresh:
        cmd.append("--fresh")
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True,
                              timeout=120)
        payload = json.loads(proc.stdout)
        if not isinstance(payload, dict):
            raise ValueError("non-object payload")
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        error = f"usage snapshot failed: {e}"
        payload = {
            "anthropic": {"ok": False, "error": error, "windows": {}},
            "openai": {"ok": False, "error": error, "windows": {}},
        }
    payload["generated_at"] = time.time()
    return payload


def payload_exit_code(payload: dict) -> int:
    a = payload.get("anthropic") or {}
    o = payload.get("openai") or {}
    return dashboard_exit_code(bool(a.get("ok")), bool(o.get("ok")))


def build_html_page(payload: dict, mode: str) -> str:
    # "</" must not appear literally inside the inline JSON script element.
    doc = json.dumps(payload).replace("</", "<\\/")
    return (HTML_TEMPLATE
            .replace("__MODE__", mode)
            .replace("__POLL_SECONDS__", str(HTML_POLL_SECONDS))
            .replace("__PAYLOAD_JSON__", doc))


def write_html_static(file_path: str, fresh: bool) -> int:
    payload = usage_payload(fresh)
    page = build_html_page(payload, "static")
    out_path = os.path.abspath(os.path.expanduser(file_path))
    parent = os.path.dirname(out_path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(page)
    print(out_path)
    return payload_exit_code(payload)


def create_html_server(payload_fn, port: int) -> ThreadingHTTPServer:
    """HTTP server on all IPv4 interfaces for the live dashboard: / and /data.json.

    Raises OSError when the port cannot be bound; callers decide policy.
    """

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):  # noqa: N802 — BaseHTTPRequestHandler API
            request_path = self.path.split("?", 1)[0]
            if request_path == "/":
                body = build_html_page(payload_fn(), "live").encode("utf-8")
                content_type = "text/html; charset=utf-8"
                status = 200
            elif request_path == "/data.json":
                body = json.dumps(payload_fn()).encode("utf-8")
                content_type = "application/json"
                status = 200
            elif request_path == "/favicon.ico":
                self.send_response(204)
                self.end_headers()
                return
            else:
                body = b"not found"
                content_type = "text/plain; charset=utf-8"
                status = 404
            try:
                self.send_response(status)
                self.send_header("Content-Type", content_type)
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)
            except OSError:
                pass  # client went away mid-response; never fatal

        def log_message(self, *_args):
            pass  # keep the terminal quiet; the page is the output

    return ThreadingHTTPServer(("0.0.0.0", port), Handler)


def run_html_server(fresh: bool, port: int = DEFAULT_HTML_PORT) -> int:
    lock = threading.Lock()
    state = {"fresh": fresh}

    def payload_now() -> dict:
        with lock:
            use_fresh = state["fresh"]
            state["fresh"] = False
            return usage_payload(use_fresh)

    try:
        server = create_html_server(payload_now, port)
    except OSError as e:
        print(f"llm-usage: cannot bind 0.0.0.0:{port} ({e.strerror or e})"
              " — is another llm-usage --html already running?"
              " Choose a different port with --port <n>.",
              file=sys.stderr)
        return 2
    bound_port = server.server_address[1]
    url = f"http://127.0.0.1:{bound_port}/"
    # Flush immediately: with stdout piped or captured, the URL must not sit
    # in a block buffer for the lifetime of the server.
    print(f"llm-usage dashboard: listening on 0.0.0.0:{bound_port}"
          f" — local URL: {url}  (Ctrl-C to stop)", flush=True)
    threading.Thread(target=webbrowser.open, args=(url,),
                     daemon=True).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


# ------------------------------------------------------------ dashboard ----

def load_dashboard_snapshot() -> dict:
    # The four loads are independent (separate hosts, separate cache files,
    # fetchers never raise), so run them concurrently: a cold refresh costs
    # the slowest request instead of the sum of all four.
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        futures = [
            pool.submit(provider_status_snapshot, "anthropic"),
            pool.submit(provider_status_snapshot, "openai"),
            pool.submit(anthropic_snapshot),
            pool.submit(openai_snapshot),
        ]
        anthropic_status, openai_status, a, o = (f.result() for f in futures)
    a["service_status"] = anthropic_status
    o["service_status"] = openai_status
    deadline = min(
        float(a["deadline"]),
        float(o["deadline"]),
        float(anthropic_status["deadline"]),
        float(openai_status["deadline"]),
    )
    return {"anthropic": a, "openai": o, "deadline": deadline}


def display_width(columns: int, clamp: bool) -> int:
    if clamp:
        return min(max(columns, 60), 140)
    return max(20, columns)


def dashboard_exit_code(a_ok: bool, o_ok: bool) -> int:
    if a_ok and o_ok:
        return 0
    return 1 if (a_ok or o_ok) else 2


def legend_lines() -> list[str]:
    legend_used = (
        f"{DIM}Used:{RESET} "
        f"{fg256(78)}{FULL}{RESET} ok  "
        f"{fg256(186)}{FULL}{RESET} 50%  "
        f"{fg256(214)}{FULL}{RESET} 75%  "
        f"{fg256(203)}{FULL}{RESET} 90%"
    )
    legend_pace = (
        f"{DIM}Pace:{RESET} "
        f"{fg256(78)}{NOW_MARK}{RESET} under  "
        f"{WHITE}{NOW_MARK}{RESET} on  "
        f"{fg256(203)}{NOW_MARK}{RESET} over"
    )
    return [legend_used, legend_pace]


def render_dashboard_snapshot(snapshot: dict, columns: int,
                              clamp_width: bool) -> tuple[list[str], int]:
    width = display_width(columns, clamp_width)
    lines = []
    a_lines, a_ok = render_provider_section(
        provider_view("anthropic", snapshot["anthropic"]), width)
    lines.extend(a_lines)
    lines.extend(["", RULE_FG + "═" * width + RESET, ""])
    o_lines, o_ok = render_provider_section(
        provider_view("openai", snapshot["openai"]), width)
    lines.extend(o_lines)
    lines.append("")
    lines.extend(legend_lines())
    lines.append("")
    return [clip_ansi(line, width) for line in lines], dashboard_exit_code(a_ok, o_ok)


def render_dashboard(columns: int, clamp_width: bool
                     ) -> tuple[dict, list[str], int]:
    snapshot = load_dashboard_snapshot()
    lines, exit_code = render_dashboard_snapshot(
        snapshot, columns, clamp_width)
    return snapshot, lines, exit_code


# ----------------------------------------------------------------- main ----

def no_cache_env() -> bool:
    return bool(os.environ.get("LLM_USAGE_NO_CACHE"))


def set_cache_read_bypass(value: bool) -> None:
    global _CACHE_READ_BYPASS
    _CACHE_READ_BYPASS = value


def parse_cache_flags(args: list[str]) -> bool:
    """Honor --fresh/--no-cache and LLM_USAGE_NO_CACHE before any fetch."""
    fresh = "--fresh" in args or "--no-cache" in args
    set_cache_read_bypass(fresh or no_cache_env())
    return fresh


def curses_color(curses_mod, color: int, pairs: dict[int, int]) -> int:
    if not curses_mod.has_colors():
        return 0
    if color == 97:
        color = 15 if curses_mod.COLORS > 15 else curses_mod.COLOR_WHITE
    elif color >= curses_mod.COLORS:
        color = {
            78: curses_mod.COLOR_GREEN,
            186: curses_mod.COLOR_YELLOW,
            214: curses_mod.COLOR_YELLOW,
            203: curses_mod.COLOR_RED,
            238: curses_mod.COLOR_WHITE,
            240: curses_mod.COLOR_WHITE,
            245: curses_mod.COLOR_WHITE,
        }.get(color, curses_mod.COLOR_WHITE)
    if color not in pairs:
        pair_id = len(pairs) + 1
        if pair_id >= curses_mod.COLOR_PAIRS:
            return 0
        try:
            curses_mod.init_pair(pair_id, color, -1)
        except curses_mod.error:
            return 0
        pairs[color] = pair_id
    return curses_mod.color_pair(pairs[color])


def apply_sgr(curses_mod, codes: list[int], style: int, color_attr: int,
              pairs: dict[int, int]) -> tuple[int, int]:
    i = 0
    if not codes:
        codes = [0]
    while i < len(codes):
        code = codes[i]
        if code == 0:
            style = 0
            color_attr = 0
        elif code == 1:
            style |= curses_mod.A_BOLD
        elif code == 2:
            style |= curses_mod.A_DIM
        elif code == 22:
            style &= ~(curses_mod.A_BOLD | curses_mod.A_DIM)
        elif code == 39:
            color_attr = 0
        elif code == 97:
            color_attr = curses_color(curses_mod, 97, pairs)
        elif code == 38 and i + 2 < len(codes) and codes[i + 1] == 5:
            color_attr = curses_color(curses_mod, codes[i + 2], pairs)
            i += 2
        i += 1
    return style, color_attr


def draw_text(stdscr, y: int, x: int, text: str, width: int, attr: int) -> int:
    if width <= 0 or not text:
        return 0
    part = text[:width]
    try:
        stdscr.addstr(y, x, part, attr)
    except Exception:
        pass
    return len(part)


def draw_ansi_line(curses_mod, stdscr, y: int, line: str, width: int,
                   pairs: dict[int, int]) -> None:
    style = 0
    color_attr = 0
    col = 0
    pos = 0
    for m in ANSI_RE.finditer(line):
        text = line[pos:m.start()]
        col += draw_text(stdscr, y, col, text, width - col,
                         style | color_attr)
        if col >= width:
            return
        raw_codes = [c for c in m.group(1).split(";") if c]
        try:
            codes = [int(c) for c in raw_codes]
        except ValueError:
            codes = [0]
        style, color_attr = apply_sgr(curses_mod, codes, style, color_attr,
                                      pairs)
        pos = m.end()
    if col < width:
        draw_text(stdscr, y, col, line[pos:], width - col, style | color_attr)


def clamp_scroll(scroll: int, line_count: int, height: int) -> int:
    return min(max(0, scroll), max(0, line_count - max(1, height)))


def draw_tui(curses_mod, stdscr, lines: list[str], scroll: int,
             pairs: dict[int, int]) -> None:
    height, width = stdscr.getmaxyx()
    stdscr.erase()
    for y in range(height):
        idx = scroll + y
        if idx >= len(lines):
            break
        draw_ansi_line(curses_mod, stdscr, y, lines[idx], width, pairs)
    stdscr.noutrefresh()
    curses_mod.doupdate()


def setup_curses(curses_mod, stdscr) -> dict[int, int]:
    stdscr.keypad(True)
    try:
        curses_mod.curs_set(0)
    except curses_mod.error:
        pass
    if curses_mod.has_colors():
        curses_mod.start_color()
        try:
            curses_mod.use_default_colors()
        except curses_mod.error:
            pass
    try:
        curses_mod.mousemask(curses_mod.ALL_MOUSE_EVENTS)
    except curses_mod.error:
        pass
    return {}


def run_tui(initial_fresh: bool) -> int:
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    try:
        import curses
    except ImportError:
        print("llm-usage: --tui requires the stdlib curses module",
              file=sys.stderr)
        return 2

    def _run(stdscr) -> int:
        pairs = setup_curses(curses, stdscr)
        height, width = stdscr.getmaxyx()
        snapshot, lines, exit_code = render_dashboard(
            width, clamp_width=False)
        if initial_fresh:
            set_cache_read_bypass(no_cache_env())
        scroll = 0
        next_data = float(snapshot["deadline"])
        next_repaint = time.time() + TUI_REPAINT_SECONDS
        draw_tui(curses, stdscr, lines, scroll, pairs)

        while True:
            now = time.time()
            if now >= next_data:
                height, width = stdscr.getmaxyx()
                snapshot, lines, exit_code = render_dashboard(
                    width, clamp_width=False)
                next_data = float(snapshot["deadline"])
                next_repaint = now + TUI_REPAINT_SECONDS
                scroll = clamp_scroll(scroll, len(lines), height)
                draw_tui(curses, stdscr, lines, scroll, pairs)
                continue
            if now >= next_repaint:
                height, width = stdscr.getmaxyx()
                lines, exit_code = render_dashboard_snapshot(
                    snapshot, width, clamp_width=False)
                next_repaint = now + TUI_REPAINT_SECONDS
                scroll = clamp_scroll(scroll, len(lines), height)
                draw_tui(curses, stdscr, lines, scroll, pairs)
                continue

            wait = min(next_data, next_repaint) - now
            stdscr.timeout(min(1000, max(50, int(wait * 1000))))
            ch = stdscr.getch()
            if ch == -1:
                continue
            if ch in (ord("q"), ord("Q"), 27):
                return exit_code
            if ch == 3:
                return 130

            height, width = stdscr.getmaxyx()
            old_scroll = scroll
            redraw = False
            if ch == curses.KEY_RESIZE:
                lines, exit_code = render_dashboard_snapshot(
                    snapshot, width, clamp_width=False)
                redraw = True
            elif ch in (curses.KEY_UP, ord("k"), ord("K")):
                scroll -= 1
            elif ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                scroll += 1
            elif ch == curses.KEY_PPAGE:
                scroll -= max(1, height - 1)
            elif ch == curses.KEY_NPAGE:
                scroll += max(1, height - 1)
            elif ch == curses.KEY_HOME:
                scroll = 0
            elif ch == curses.KEY_END:
                scroll = len(lines)
            elif ch == curses.KEY_MOUSE:
                try:
                    _id, _x, _y, _z, bstate = curses.getmouse()
                except curses.error:
                    bstate = 0
                if bstate & getattr(curses, "BUTTON4_PRESSED", 0):
                    scroll -= 3
                elif bstate & getattr(curses, "BUTTON5_PRESSED", 0):
                    scroll += 3

            scroll = clamp_scroll(scroll, len(lines), height)
            if redraw or scroll != old_scroll:
                draw_tui(curses, stdscr, lines, scroll, pairs)

    try:
        return curses.wrapper(_run)
    except KeyboardInterrupt:
        return 130


def parse_html_flags(args: list[str]
                     ) -> tuple[bool, str | None, str | None]:
    """Return (html, html_static_path, error) from the argument list."""
    html = "--html" in args
    static_path = None
    error = None
    if "--html-static" in args:
        idx = args.index("--html-static")
        if idx + 1 >= len(args) or args[idx + 1].startswith("--"):
            error = "--html-static requires an output path"
        else:
            static_path = args[idx + 1]
    return html, static_path, error


def parse_port_flag(args: list[str]) -> tuple[int | None, str | None]:
    """Return (port, error) for --port; port is None when the flag is absent."""
    if "--port" not in args:
        return None, None
    idx = args.index("--port")
    if idx + 1 >= len(args):
        return None, "--port requires a port number"
    raw = args[idx + 1]
    try:
        port = int(raw)
    except ValueError:
        return None, f"--port requires a port number, got {raw!r}"
    if not 1 <= port <= 65535:
        return None, f"--port must be between 1 and 65535, got {port}"
    return port, None


def main() -> None:
    args = sys.argv[1:]
    if "--version" in args:
        print(f"llm-usage {__version__}")
        return
    fresh = parse_cache_flags(args)
    tui = "--tui" in args
    json_mode = "--json" in args
    html, html_static, html_error = parse_html_flags(args)
    port, port_error = parse_port_flag(args)
    if html_error or port_error:
        print(f"llm-usage: {html_error or port_error}", file=sys.stderr)
        sys.exit(2)
    if port is not None and not html:
        print("llm-usage: --port requires --html", file=sys.stderr)
        sys.exit(2)
    if sum([tui, json_mode, html, html_static is not None]) > 1:
        print("llm-usage: choose at most one of "
              "--tui, --json, --html, --html-static",
              file=sys.stderr)
        sys.exit(2)
    if json_mode:
        sys.exit(emit_json())
    if html_static is not None:
        sys.exit(write_html_static(html_static, fresh))
    if html:
        sys.exit(run_html_server(
            fresh, DEFAULT_HTML_PORT if port is None else port))
    if tui:
        if not sys.stdout.isatty():
            print("llm-usage: --tui requires an interactive terminal",
                  file=sys.stderr)
            sys.exit(2)
        sys.exit(run_tui(initial_fresh=fresh))

    width = shutil.get_terminal_size((100, 24)).columns
    _snapshot, lines, exit_code = render_dashboard(width, clamp_width=True)
    for line in lines:
        print(line)
    if exit_code:
        sys.exit(exit_code)


if __name__ == "__main__":
    code = 0
    try:
        main()
    except KeyboardInterrupt:
        code = 130
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else 0
    except BrokenPipeError:
        code = 141  # 128 + SIGPIPE, the conventional code
    # Flush here, inside a guard: a downstream pipe (head, less quit early)
    # closing otherwise raises an unhandled BrokenPipeError in the
    # interpreter's exit flush.
    try:
        sys.stdout.flush()
    except BrokenPipeError:
        code = 141
    if code == 141:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    sys.exit(code)
