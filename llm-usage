# ---------------------------------------------------------------- ANSI ----

RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"


def fg256(n: int) -> str:
    return f"\033[38;5;{n}m"


WHITE = "\033[97m"
DIM_GRAY = fg256(238)
SUB_FG = fg256(245)
RULE_FG = fg256(240)


def color_for_pct(p: float) -> str:
    if p < 50:
        return fg256(78)   # green
    if p < 75:
        return fg256(186)  # yellow
    if p < 90:
        return fg256(214)  # orange
    return fg256(203)      # red


def visible_len(s: str) -> int:
    return len(re.sub(r"\033\[[0-9;]*m", "", s))


ANSI_RE = re.compile(r"\033\[([0-9;]*)m")


def clip_ansi(s: str, width: int) -> str:
    """Clip a string to a display width without counting SGR escapes."""
    if width <= 0:
        return ""
    if visible_len(s) <= width:
        return s

    out = []
    col = 0
    pos = 0
    clipped = False
    for m in ANSI_RE.finditer(s):
        text = s[pos:m.start()]
        for ch in text:
            if col >= width:
                clipped = True
                break
            out.append(ch)
            col += 1
        if col < width:
            out.append(m.group(0))
        else:
            clipped = True
            break
        pos = m.end()

    if not clipped:
        for ch in s[pos:]:
            if col >= width:
                clipped = True
                break
            out.append(ch)
            col += 1

    if "\033[" in s:
        out.append(RESET)
    return "".join(out)


def fit_text(s: str, width: int) -> str:
    if width <= 0:
        return ""
    if len(s) <= width:
        return s
    if width == 1:
        return s[:1]
    return s[:width - 1] + "…"


# ----------------------------------------------------- token loaders ----

def jwt_claims(token: str | None) -> dict | None:
    """Decode a JWT payload without verification — local expiry inspection
    only, never trust-establishing."""
    if not token or token.count(".") != 2:
        return None
    payload = token.split(".")[1]
    payload += "=" * (-len(payload) % 4)
    try:
        return json.loads(base64.urlsafe_b64decode(payload))
    except Exception:
        return None


def load_anthropic_token() -> dict | None:
    if t := os.environ.get("CLAUDE_CODE_OAUTH_TOKEN"):
        return {"access_token": t, "expires_at_ms": None,
                "subscription": None, "org": None}
    user = os.environ.get("USER", "")
    if user and sys.platform == "darwin":
        try:
            out = subprocess.check_output(
                ["security", "find-generic-password",
                 "-s", "Claude Code-credentials",
                 "-a", user, "-w"],
                stderr=subprocess.DEVNULL,
            ).decode().strip()
            d = json.loads(out)
            c = d.get("claudeAiOauth", {})
            return {
                "access_token": c.get("accessToken"),
                "expires_at_ms": c.get("expiresAt"),
                "subscription": c.get("subscriptionType"),
                "org": d.get("organizationUuid"),
            }
        except (subprocess.CalledProcessError, json.JSONDecodeError, OSError):
            pass
    p = os.path.expanduser("~/.claude/.credentials.json")
    if os.path.exists(p):
        try:
            with open(p) as f:
                d = json.load(f)
        except (OSError, json.JSONDecodeError):
            return None
        c = d.get("claudeAiOauth", {})
        return {
            "access_token": c.get("accessToken"),
            "expires_at_ms": c.get("expiresAt"),
            "subscription": c.get("subscriptionType"),
            "org": d.get("organizationUuid"),
        }
    return None


def load_codex_token() -> dict | None:
    tok: dict | None = None
    if t := os.environ.get("CODEX_OAUTH_TOKEN"):
        tok = {"access_token": t, "account_id": None,
               "source": "environment"}
    else:
        p = os.path.expanduser("~/.codex/auth.json")
        if os.path.exists(p):
            try:
                with open(p) as f:
                    d = json.load(f)
            except (OSError, json.JSONDecodeError):
                return None
            toks = d.get("tokens", {}) or {}
            tok = {
                "access_token": toks.get("access_token"),
                "account_id": toks.get("account_id"),
                "auth_mode": d.get("auth_mode"),
                "source": "auth_file",
            }
    if tok:
        # Codex access tokens are JWTs; the exp claim is the OAuth expiry.
        claims = jwt_claims(tok.get("access_token")) or {}
        exp = claims.get("exp")
        tok["expires_at_ms"] = exp * 1000 if isinstance(exp, (int, float)) \
            else None
    return tok


# ---------------------------------------------------------------- HTTP ----

def http_get_json_response(url: str, headers: dict, timeout: int = 15
                           ) -> tuple[int | None, Any, dict[str, str]]:
    """GET JSON without raising, preserving response headers for backoff."""
    req = urllib.request.Request(url, method="GET", headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            response_headers = {
                key.lower(): value for key, value in r.headers.items()
            }
            return r.status, json.loads(r.read().decode()), response_headers
    except urllib.error.HTTPError as e:
        response_headers = {
            key.lower(): value
            for key, value in (e.headers.items() if e.headers else [])
        }
        try:
            body = json.loads(e.read().decode())
        except Exception:
            body = {"error": "http", "code": e.code}
        return e.code, body, response_headers
    except Exception as e:
        return None, {"error": str(e)}, {}


def http_get_json(url: str, headers: dict, timeout: int = 15
                  ) -> tuple[int | None, Any]:
    code, body, _headers = http_get_json_response(url, headers, timeout)
    return code, body


def fetch_anthropic(tok: dict) -> tuple[int | None, Any]:
    return http_get_json(
        "https://api.anthropic.com/api/oauth/usage",
        {
            "Authorization": f"Bearer {tok['access_token']}",
            "User-Agent": "claude-cli/1.0 (external, cli)",
            "anthropic-beta": "oauth-2025-04-20",
        },
    )


def fetch_codex(tok: dict) -> tuple[int | None, Any]:
    headers = {
        "Authorization": f"Bearer {tok['access_token']}",
        "User-Agent": "codex_cli_rs/0.45.0 (macOS; arm64)",
        "Originator": "codex_cli_rs",
        "Accept": "application/json",
    }
    if tok.get("account_id"):
        headers["Chatgpt-Account-Id"] = tok["account_id"]
    code, body = http_get_json(
        "https://chatgpt.com/backend-api/wham/usage", headers)
    if (code == 200 and isinstance(body, dict)
            and tok.get("source") == "auth_file"
            and openai_reset_credit_count(body) > 0):
        details = fetch_codex_reset_credit_details()
        if details is not None:
            body = dict(body)
            body["rate_limit_reset_credits"] = details
    return code, body


def fetch_codex_reset_credit_details(timeout: float = 5.0
                                     ) -> dict | None:
    """Fetch optional per-credit expirations from a local Codex app-server."""
    codex = shutil.which("codex")
    if not codex:
        return None

    proc: subprocess.Popen | None = None
    lines: queue.Queue[str | None] = queue.Queue()
    request_id = "llm-usage-rate-limits"
    try:
        proc = subprocess.Popen(
            [codex, "app-server", "--stdio"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            bufsize=1,
        )
        assert proc.stdin is not None
        assert proc.stdout is not None

        def read_stdout() -> None:
            try:
                for line in proc.stdout:
                    lines.put(line)
            finally:
                lines.put(None)

        threading.Thread(target=read_stdout, daemon=True).start()
        messages = [
            {
                "method": "initialize",
                "id": "llm-usage-initialize",
                "params": {
                    "clientInfo": {
                        "name": "llm-usage",
                        "title": "llm-usage",
                        "version": "1",
                    }
                },
            },
            {"method": "initialized", "params": {}},
            {"method": "account/rateLimits/read", "id": request_id},
        ]
        for message in messages:
            proc.stdin.write(json.dumps(message) + "\n")
        proc.stdin.flush()

        deadline = time.monotonic() + timeout
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            try:
                line = lines.get(timeout=remaining)
            except queue.Empty:
                return None
            if line is None:
                return None
            try:
                message = json.loads(line)
            except json.JSONDecodeError:
                continue
            if message.get("id") != request_id:
                continue
            raw = (message.get("result") or {}).get(
                "rateLimitResetCredits")
            return normalize_codex_reset_credits(raw)
    except (OSError, BrokenPipeError, TypeError, ValueError):
        return None
    finally:
        if proc is not None and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=1)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()


def normalize_codex_reset_credits(raw: Any) -> dict | None:
    """Convert app-server camelCase reset-credit details to cache JSON."""
    if not isinstance(raw, dict):
        return None
    count = raw.get("availableCount")
    if not isinstance(count, (int, float)) or isinstance(count, bool):
        return None
    normalized: dict[str, Any] = {"available_count": max(0, int(count))}
    credits = raw.get("credits")
    if credits is None:
        normalized["credits"] = None
        return normalized
    if not isinstance(credits, list):
        return None
    normalized["credits"] = [
        {
            "id": credit.get("id"),
            "reset_type": credit.get("resetType"),
            "status": credit.get("status"),
            "granted_at": credit.get("grantedAt"),
            "expires_at": credit.get("expiresAt"),
            "title": credit.get("title"),
            "description": credit.get("description"),
        }
        for credit in credits
        if isinstance(credit, dict)
    ]
    return normalized


# --------------------------------------------------------------- cache ----
#
# The undocumented usage endpoints are rate-limited and return 429s under load,
# so we hit them at most once per TTL window per provider. Two TTLs apply:
#
#   * Success (HTTP 200): cached for cache_ttl() — default 10 minutes for
#     OpenAI, 20 minutes for Anthropic (its endpoint rate-limits harder). Any
#     run within the window reuses the response without a network call.
#   * Rate-limit (HTTP 429): NEGATIVELY cached for rate_limit_ttl() (default
#     20 minutes). Once we're told we're rate-limited, we make no new call for
#     the whole negative window — repeatedly running the tool won't keep poking
#     a limited endpoint and prolonging the block; it just reports the backoff.
#
# Any other failure (401, 5xx, network error) is NOT cached, so it retries on
# the very next run. Both the TUI and --json paths share the cache via
# cached_fetch(). --fresh/--no-cache (or LLM_USAGE_NO_CACHE) bypass reads;
# LLM_USAGE_CACHE_TTL=0 disables caching entirely.

DEFAULT_CACHE_TTL = 600        # seconds — generic/OpenAI success: "once per ten minutes"
ANTHROPIC_CACHE_TTL = 1200     # seconds — Anthropic success: doubled. Its usage
                               # endpoint 429s harder under load, so we poll it
                               # at most half as often as the generic default.
DEFAULT_RATE_LIMIT_TTL = 1200  # seconds — 429 backoff: "no new call for 20 min"
DEFAULT_STATUS_TTL = 60        # public status pages: at most once per minute
DEFAULT_STATUS_RETRY_TTL = 300 # failed status check: start with a 5m backoff
MAX_STATUS_RETRY_TTL = 3600
DEFAULT_TUI_RETRY_SECONDS = 60
TUI_REPAINT_SECONDS = 60
_CACHE_READ_BYPASS = False     # set by --fresh/--no-cache or env


def _caching_off() -> bool:
    """True when cache reads and writes are disabled by TTL configuration."""
    raw = os.environ.get("LLM_USAGE_CACHE_TTL")
    if raw is not None:
        try:
            return int(raw) <= 0
        except ValueError:
            return False
    return False


def cache_ttl(provider: str | None = None) -> int:
    """Success-cache TTL in seconds; 0 means caching is disabled.

    This is the minimum delta between real (HTTP 200) calls to a provider's
    usage endpoint — any run inside the window is served from cache. The default
    is provider-specific: Anthropic's endpoint rate-limits more aggressively, so
    its floor (ANTHROPIC_CACHE_TTL) is double the generic default. An explicit
    LLM_USAGE_CACHE_TTL takes manual control and applies to every provider as-is.
    """
    if _caching_off():
        return 0

    def _default() -> int:
        return ANTHROPIC_CACHE_TTL if provider == "anthropic" else DEFAULT_CACHE_TTL

    raw = os.environ.get("LLM_USAGE_CACHE_TTL")
    if raw is None:
        return _default()
    try:
        return int(raw)
    except ValueError:
        return _default()


def rate_limit_ttl() -> int:
    """Negative-cache TTL for 429s in seconds; 0 means caching is disabled.

    Independent of cache_ttl(): a custom LLM_USAGE_CACHE_TTL changes only the
    success window, while the 429 backoff stays at its own default unless
    LLM_USAGE_RATE_LIMIT_TTL is set.
    """
    if _caching_off():
        return 0
    raw = os.environ.get("LLM_USAGE_RATE_LIMIT_TTL")
    if raw is None:
        return DEFAULT_RATE_LIMIT_TTL
    try:
        v = int(raw)
        return v if v > 0 else DEFAULT_RATE_LIMIT_TTL
    except ValueError:
        return DEFAULT_RATE_LIMIT_TTL


def _cache_dir() -> str:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(base, "llm-usage")


def _cache_path(provider: str) -> str:
    return os.path.join(_cache_dir(), f"{provider}.json")


def cache_read(provider: str) -> tuple[int | None, Any, float] | None:
    """Return (code, body, age_seconds) for a fresh cache entry, else None.

    The TTL applied depends on the cached status: a 429 entry lives for
    rate_limit_ttl() (negative cache / backoff), anything else (a 200) for
    cache_ttl().
    """
    if _CACHE_READ_BYPASS or _caching_off():
        return None
    try:
        with open(_cache_path(provider)) as f:
            d = json.load(f)
    except (OSError, json.JSONDecodeError):
        return None
    ts = d.get("ts")
    if not isinstance(ts, (int, float)):
        return None
    code = d.get("code")
    ttl = rate_limit_ttl() if code == 429 else cache_ttl(provider)
    if ttl <= 0:
        return None
    now = time.time()
    age = now - ts
    if age < 0 or age > ttl:
        return None
    if provider == "openai" and code == 200:
        expiry = openai_next_reset_credit_expiry(
            d.get("body") or {}, require_future=False)
        if expiry is not None and now >= expiry:
            return None
    return code, d.get("body"), age


def cache_write(provider: str, code: int | None, body: Any) -> None:
    """Persist a fetch result. Best-effort: cache I/O never breaks a run."""
    path = _cache_path(provider)
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        os.makedirs(_cache_dir(), exist_ok=True)
        with open(tmp, "w") as f:
            json.dump({"ts": time.time(), "code": code, "body": body}, f)
        os.replace(tmp, path)  # atomic — concurrent runs never see a partial
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def cached_fetch(provider: str, fetch_fn, tok: dict
                 ) -> tuple[int | None, Any, float | None]:
    """Fetch with a per-provider TTL cache.

    Returns (code, body, cache_age): cache_age is None for a live network
    call, or the age in seconds of the served cache entry. A 200 is cached for
    the success TTL and a 429 for the (longer) rate-limit backoff TTL; any
    other status falls through to a live call next time so transient errors
    don't get pinned.
    """
    hit = cache_read(provider)
    if hit is not None:
        code, body, age = hit
        return code, body, age
    code, body = fetch_fn(tok)
    if code in (200, 429) and not _caching_off():
        cache_write(provider, code, body)
    return code, body, None


def cache_notice(code: int | None, age: float | None) -> str | None:
    """Return a dim 'served from cache' header annotation for a cached success.

    Cached 429s are surfaced by the sections' rate-limit branch instead, so
    this stays quiet for them.
    """
    if age is None or code != 200:
        return None
    return f"{DIM}[↻ cached {fmt_relative(age)} ago]{RESET}"


# ------------------------------------------------------ provider status ----

STATUS_URLS = {
    "anthropic": "https://status.claude.com/api/v2/summary.json",
    "openai": "https://status.openai.com/api/v2/summary.json",
}


def status_ttl() -> int:
    """Persistent public-status cache TTL; zero disables all caching."""
    if _caching_off():
        return 0
    raw = os.environ.get("LLM_USAGE_STATUS_TTL")
    if raw is None:
        return DEFAULT_STATUS_TTL
    try:
        value = int(raw)
        return value if value >= 0 else DEFAULT_STATUS_TTL
    except ValueError:
        return DEFAULT_STATUS_TTL


def _status_cache_key(provider: str) -> str:
    return f"status-{provider}"


def _read_cache_document(cache_key: str) -> dict | None:
    try:
        with open(_cache_path(cache_key)) as f:
            document = json.load(f)
    except (OSError, json.JSONDecodeError):
        return None
    return document if isinstance(document, dict) else None


def _write_cache_document(cache_key: str, document: dict) -> None:
    """Atomically persist a cache document; failures never break rendering."""
    file_path = _cache_path(cache_key)
    tmp = f"{file_path}.{os.getpid()}.tmp"
    try:
        os.makedirs(_cache_dir(), exist_ok=True)
        with open(tmp, "w") as f:
            json.dump(document, f)
        os.replace(tmp, file_path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def _retry_after_seconds(value: str | None, now: float) -> float | None:
    if not value:
        return None
    try:
        return max(0.0, float(value))
    except ValueError:
        pass
    try:
        retry_at = email.utils.parsedate_to_datetime(value)
        if retry_at.tzinfo is None:
            retry_at = retry_at.replace(tzinfo=timezone.utc)
        return max(0.0, retry_at.timestamp() - now)
    except (TypeError, ValueError, OverflowError):
        return None


def _status_retry_seconds(failures: int, retry_after: str | None,
                          now: float) -> float:
    explicit = _retry_after_seconds(retry_after, now)
    if explicit is not None:
        return max(1.0, explicit)
    base = min(
        MAX_STATUS_RETRY_TTL,
        DEFAULT_STATUS_RETRY_TTL * (3 ** max(0, failures - 1)),
    )
    return max(1.0, base * random.uniform(0.9, 1.1))


def normalize_provider_status(provider: str, body: Any) -> dict | None:
    """Normalize the shared Statuspage-style summary response."""
    if not isinstance(body, dict):
        return None
    raw_status = body.get("status")
    if not isinstance(raw_status, dict):
        return None
    indicator = str(raw_status.get("indicator") or "unknown").lower()
    description = str(
        raw_status.get("description") or "Status unavailable").strip()
    affected = []
    for component in body.get("components") or []:
        if not isinstance(component, dict):
            continue
        component_state = str(
            component.get("status") or "unknown").lower()
        if component_state not in ("operational",):
            affected.append({
                "name": str(component.get("name") or "Unknown component"),
                "status": component_state,
            })
    return {
        "provider": provider,
        "indicator": indicator,
        "description": description,
        "operational": indicator == "none" and not affected,
        "affected_components": affected,
    }


def _status_error_text(code: int | None, body: Any) -> str:
    if code is None:
        if isinstance(body, dict) and body.get("error"):
            return str(body["error"])
        return "network error"
    if code == 200:
        return "invalid status response"
    return f"HTTP {code}"


def provider_status_snapshot(provider: str) -> dict:
    """Load a provider's public status with caching and stale-if-error.

    A successful response is reused for at least a minute across processes.
    Failed refreshes retain the last known state and establish a persistent,
    escalating retry deadline so repeated CLI launches cannot hammer the site.
    """
    loaded_at = time.time()
    cache_key = _status_cache_key(provider)
    ttl = status_ttl()
    cached = (
        None if ttl <= 0 else _read_cache_document(cache_key)
    )
    cached = cached or {}
    cached_body = cached.get("body")
    cached_ts = cached.get("ts")
    retry_at = cached.get("retry_at")

    if (not _CACHE_READ_BYPASS and isinstance(retry_at, (int, float))
            and retry_at > loaded_at):
        return {
            "provider": provider,
            "status": normalize_provider_status(provider, cached_body),
            "cached": cached_body is not None,
            "stale": True,
            "age": (max(0.0, loaded_at - cached_ts)
                    if isinstance(cached_ts, (int, float)) else None),
            "error": cached.get("last_error") or "status refresh failed",
            "loaded_at": loaded_at,
            "deadline": float(retry_at),
        }

    if (not _CACHE_READ_BYPASS and ttl > 0
            and isinstance(cached_ts, (int, float))
            and loaded_at >= cached_ts
            and loaded_at - cached_ts <= ttl):
        return {
            "provider": provider,
            "status": normalize_provider_status(provider, cached_body),
            "cached": True,
            "stale": False,
            "age": loaded_at - cached_ts,
            "error": None,
            "loaded_at": loaded_at,
            "deadline": cached_ts + ttl,
        }

    headers = {
        "Accept": "application/json",
        "User-Agent": "llm-usage/1 status-monitor",
    }
    if cached.get("etag"):
        headers["If-None-Match"] = str(cached["etag"])
    code, body, response_headers = http_get_json_response(
        STATUS_URLS[provider], headers)

    if code == 304 and cached_body is not None:
        document = {
            "ts": loaded_at,
            "body": cached_body,
            "etag": response_headers.get("etag") or cached.get("etag"),
            "failures": 0,
            "retry_at": None,
            "last_error": None,
        }
        if ttl > 0:
            _write_cache_document(cache_key, document)
        return {
            "provider": provider,
            "status": normalize_provider_status(provider, cached_body),
            "cached": True,
            "stale": False,
            "age": 0.0,
            "error": None,
            "loaded_at": loaded_at,
            "deadline": loaded_at + max(1, ttl or DEFAULT_STATUS_TTL),
        }

    normalized = normalize_provider_status(provider, body)
    if code == 200 and normalized is not None:
        document = {
            "ts": loaded_at,
            "body": body,
            "etag": response_headers.get("etag"),
            "failures": 0,
            "retry_at": None,
            "last_error": None,
        }
        if ttl > 0:
            _write_cache_document(cache_key, document)
        return {
            "provider": provider,
            "status": normalized,
            "cached": False,
            "stale": False,
            "age": None,
            "error": None,
            "loaded_at": loaded_at,
            "deadline": loaded_at + max(1, ttl or DEFAULT_STATUS_TTL),
        }

    failures = max(0, int(cached.get("failures") or 0)) + 1
    retry_seconds = _status_retry_seconds(
        failures, response_headers.get("retry-after"), loaded_at)
    retry_at = loaded_at + retry_seconds
    error = _status_error_text(code, body)
    if ttl > 0:
        document = dict(cached)
        document.update({
            "failures": failures,
            "retry_at": retry_at,
            "last_error": error,
            "last_attempt": loaded_at,
        })
        _write_cache_document(cache_key, document)
    return {
        "provider": provider,
        "status": normalize_provider_status(provider, cached_body),
        "cached": cached_body is not None,
        "stale": True,
        "age": (max(0.0, loaded_at - cached_ts)
                if isinstance(cached_ts, (int, float)) else None),
        "error": error,
        "loaded_at": loaded_at,
        "deadline": retry_at,
    }


def provider_status_json(snapshot: dict | None) -> dict:
    snapshot = snapshot or {}
    normalized = snapshot.get("status")
    return {
        "available": normalized is not None,
        "operational": (
            normalized.get("operational") if normalized is not None else None
        ),
        "indicator": (
            normalized.get("indicator") if normalized is not None else None
        ),
        "description": (
            normalized.get("description") if normalized is not None else None
        ),
        "affected_components": (
            normalized.get("affected_components")
            if normalized is not None else []
        ),
        "cached": bool(snapshot.get("cached")),
        "stale": bool(snapshot.get("stale")),
        "cache_age_seconds": snapshot.get("age"),
        "error": snapshot.get("error"),
    }


def provider_status_line(snapshot: dict | None) -> str | None:
    snapshot = snapshot or {}
    normalized = snapshot.get("status")
    stale = bool(snapshot.get("stale"))
    error = snapshot.get("error")
    if normalized is None:
        if error:
            return (f"  {fg256(214)}? Service status unavailable "
                    f"({error}){RESET}")
        return None

    if normalized.get("operational") and not stale:
        return None
    indicator = normalized.get("indicator")
    if indicator in ("major", "critical"):
        color = fg256(203)
    elif indicator == "minor":
        color = fg256(214)
    else:
        color = fg256(186)
    text = str(normalized.get("description") or "Service disruption")
    if stale:
        age = snapshot.get("age")
        confirmed = (
            f", last confirmed {fmt_relative(age)} ago"
            if isinstance(age, (int, float)) else ", last confirmed earlier"
        )
        if normalized.get("operational"):
            return (f"  {fg256(214)}? Service status unavailable; "
                    f"last known: {text}{confirmed}{RESET}")
        text += confirmed
    return f"  {color}● Service status: {text}{RESET}"


# ----------------------------------------------------------- bar render ----

FULL = "█"
EMPTY = "░"
NOW_MARK = "▼"


def render_bar(width: int, usage_pct: float) -> tuple[str, bool]:
    """Return (bar_string, overflow). Width is total cells."""
    width = max(width, 4)
    overflow = usage_pct > 100
    fill_cells = round(min(max(0, usage_pct), 100) / 100 * width)
    color = color_for_pct(usage_pct)
    cells = []
    for i in range(width):
        if i < fill_cells:
            cells.append(color + FULL + RESET)
        else:
            cells.append(DIM_GRAY + EMPTY + RESET)
    return "".join(cells), overflow


# ---------------------------------------------------------- time helpers ----

def parse_iso(s: str | None) -> datetime | None:
    if not s:
        return None
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    try:
        return datetime.fromisoformat(s)
    except ValueError:
        return None


def fmt_local(dt: datetime | None) -> str:
    if not dt:
        return "—"
    return dt.astimezone().strftime("%a %b %d %H:%M %Z")


def fmt_relative(seconds: float | None) -> str:
    if seconds is None:
        return "—"
    s = int(max(0, seconds))
    d, rem = divmod(s, 86400)
    h, rem = divmod(rem, 3600)
    m, _ = divmod(rem, 60)
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m:02d}m"
    return f"{m}m"


def fmt_window(seconds: int) -> str:
    if seconds % 86400 == 0 and seconds >= 86400:
        d = seconds // 86400
        return f"{d}-day" if d > 1 else "1-day"
    if seconds % 3600 == 0:
        h = seconds // 3600
        return f"{h}-hour"
    return f"{seconds}s"


# ------------------------------------------------------------------ row ----

def label_width(width: int) -> int:
    if width < 46:
        return 10
    if width < 72:
        return 14
    return 18


def row_layout_widths(labels: list[str], usage_pcts: list[float],
                      width: int) -> tuple[int, int]:
    label_gap_w = 2
    bar_gap_w = 1
    overflow_w = 2
    min_bar = 4 if width < 46 else 8
    pct_w = max((len(f"{pct:.0f}%") for pct in usage_pcts), default=3)
    max_label_w = max(
        1,
        width - label_gap_w - pct_w - bar_gap_w - overflow_w - min_bar,
    )
    if not labels:
        return min(label_width(width), max_label_w), pct_w
    return min(max(len(label) for label in labels), max_label_w), pct_w


def row(label: str, usage_pct: float, now_pct: float | None,
        reset_dt: datetime | None, reset_seconds: float | None,
        width: int, label_w: int | None = None,
        pct_w: int | None = None) -> str:
    label_w = label_width(width) if label_w is None else label_w
    raw_label = fit_text(label, label_w)
    label_gap_w = 2
    label_col_w = label_w + label_gap_w
    pct_text = f"{usage_pct:.0f}%"
    pct_col_w = max(pct_w if pct_w is not None else 0, len(pct_text))
    pct_str = f"{pct_text:>{pct_col_w}}"
    bar_gap_w = 1
    overflow_w = 2
    min_bar = 4 if width < 46 else 8
    bar_w = max(min_bar,
                width - label_col_w - pct_col_w - bar_gap_w - overflow_w)
    bar, overflow = render_bar(bar_w, usage_pct)
    lbl = f"{BOLD}{raw_label:<{label_w}}{RESET}{' ' * label_gap_w}"
    pct_color = color_for_pct(usage_pct)
    overflow_mark = f" {fg256(203)}↑{RESET}" if overflow else "  "
    line1 = f"{lbl}{pct_color}{pct_str}{RESET} {bar}{overflow_mark}"
    bar_start = label_col_w + pct_col_w + bar_gap_w

    line0 = ""
    countdown_text = (
        f"in {fmt_relative(reset_seconds)}"
        if reset_seconds is not None else None
    )
    if now_pct is not None:
        margin = usage_pct - now_pct
        if usage_pct >= now_pct + 5:
            pace_color = fg256(203)
            verdict = "over pace"
        elif usage_pct <= now_pct - 5:
            pace_color = fg256(78)
            verdict = "under pace"
        else:
            pace_color = WHITE
            verdict = "on pace"
        if verdict == "on pace":
            pace_text = "≈ on pace"
        elif width < 64:
            arrow = "↑" if verdict == "over pace" else "↓"
            pace_text = f"{arrow} {margin:+.0f}pp"
        else:
            arrow = "↑" if verdict == "over pace" else "↓"
            pace_text = f"{arrow} {margin:+.0f}pp {verdict}"
        now_idx = min(max(0, round(now_pct / 100 * bar_w)), bar_w - 1)
        marker_col = bar_start + now_idx
        now_label = f"{now_pct:.0f}%"
        marker_pad = "  "
        segment_sep = " · "
        left_segments = []
        right_segments = []

        def joined_text(segments: list[tuple[str, str]]) -> str:
            return segment_sep.join(text for text, _color in segments)

        def left_text(segments: list[tuple[str, str]]) -> str:
            if segments:
                return now_label + " " + joined_text(segments) + marker_pad
            return now_label + marker_pad

        def right_text(segments: list[tuple[str, str]]) -> str:
            if segments:
                return marker_pad + joined_text(segments)
            return ""

        right_capacity = width - marker_col - len(NOW_MARK)
        for segment in [(pace_text, pace_color), (countdown_text, SUB_FG)]:
            text, color = segment
            if not text:
                continue
            candidate = right_segments + [(text, color)]
            if len(right_text(candidate)) <= right_capacity:
                right_segments = candidate
                continue
            candidate = left_segments + [(text, color)]
            if len(left_text(candidate)) <= marker_col:
                left_segments = candidate

        def colored_segments(segments: list[tuple[str, str]]) -> str:
            out = []
            for i, (text, color) in enumerate(segments):
                if i:
                    out.append(SUB_FG + segment_sep + RESET)
                out.append(color + text + RESET)
            return "".join(out)

        left = pace_color + now_label + RESET
        if left_segments:
            left += " " + colored_segments(left_segments)
        left += marker_pad
        right = ""
        if right_segments:
            right = marker_pad + colored_segments(right_segments)
        marker_start = marker_col - visible_len(left)
        line0 = (
            " " * marker_start
            + left
            + pace_color + NOW_MARK + RESET
            + right
        )
    elif countdown_text:
        line0 = " " * bar_start + SUB_FG + countdown_text + RESET

    return "\n".join([
        clip_ansi(line0, width),
        clip_ansi(line1, width),
    ])


