# ------------------------------------------------------------ json output ----
#
# `--json` emits a machine-readable snapshot for schedulers (e.g. bin/checkpoint)
# that route work to whichever subscription has the most headroom. Both providers
# are normalized to a uniform shape: each relevant window reports `utilization`
# as a percent (0-100) plus seconds-until-reset. Each provider also includes
# its provider-specific additional limits and read-only credit/spend status.




def _anthropic_view_data(snapshot: dict, display: dict) -> dict:
    tok, body = snapshot["token"], snapshot["body"]
    now = datetime.now(timezone.utc)
    windows: dict[str, Any] = {}
    for band in anthropic_limit_bands(body):
        reset_dt = parse_iso(band.get("resets_at"))
        rem = (reset_dt - now).total_seconds() if reset_dt else None
        windows[band["key"]] = {
            "label": band["label"],
            "utilization": band["utilization"],
            "resets_at": band.get("resets_at"),
            "reset_seconds": rem,
            "window_seconds": band["window_seconds"],
            "kind": band.get("kind"),
            "group": band.get("group"),
            "is_active": band.get("is_active"),
            "severity": band.get("severity"),
            "source": band.get("source"),
        }
        display["rows"].append(usage_row(
            band["label"], band["utilization"], band["window_seconds"], rem))
    display["extras"] = anthropic_extras_parts(body)
    return {"ok": True, "error": None,
            "subscription": tok.get("subscription"), "windows": windows,
            "usage_credits": normalize_anthropic_spend(body),
            "rate_limit_reset_credits": anthropic_reset_grants(body),
            "oauth_expires_at_ms": tok.get("expires_at_ms")}


def _openai_windows_json(bands: list[dict]) -> dict[str, Any]:
    return {
        band["key"]: {
            "label": band["label"],
            "utilization": band["utilization"],
            "reset_seconds": band["reset_seconds"],
            "reset_at": band["reset_at"],
            "window_seconds": band["window_seconds"],
        }
        for band in bands
    }


def _band_rows(bands: list[dict]) -> list[dict]:
    return [usage_row(b["label"], b["utilization"], b["window_seconds"],
                      b["reset_seconds"]) for b in bands]


def _openai_view_data(snapshot: dict, display: dict) -> dict:
    tok, body = snapshot["token"], snapshot["body"]
    rl = body.get("rate_limit") or {}
    bands = openai_bands(snapshot, rl)
    display["rows"].extend(_band_rows(bands))
    additional = []
    for group in openai_additional_rate_limits(body):
        rate_limit = group["rate_limit"]
        group_bands = openai_bands(snapshot, rate_limit)
        in_use = openai_limit_in_use(rate_limit)
        additional.append({
            "name": group["name"],
            "display_name": group["display_name"],
            "metered_feature": group["metered_feature"],
            "normal_model_slug": group["normal_model_slug"],
            "in_use": in_use,
            "allowed": bool(rate_limit.get("allowed", True)),
            "limit_reached": bool(rate_limit.get("limit_reached")),
            "windows": _openai_windows_json(group_bands),
        })
        # Named allowances (Codex Spark, Luna Reserve) only earn rows once
        # something has actually drawn on them.
        if in_use and group_bands:
            display["rows"].append({
                "type": "heading",
                "text": group["display_name"],
                "badges": openai_limit_badges(rate_limit),
            })
            display["rows"].extend(_band_rows(group_bands))
    if rl.get("limit_reached"):
        display["alerts"].append(
            seg("● limit reached — requests will be rejected", "critical"))
    elif not rl.get("allowed", True):
        display["alerts"].append(
            seg("⚠ requests not currently allowed", "warn"))
    display["extras"] = openai_extras_parts(body)

    credits = body.get("credits") or {}
    next_credit_expiry = openai_next_reset_credit_expiry(body)
    return {"ok": True, "error": None,
            "plan": body.get("plan_type"),
            "oauth_expires_at_ms": tok.get("expires_at_ms"),
            "limit_reached": bool(rl.get("limit_reached")),
            "windows": _openai_windows_json(bands),
            "additional_rate_limits": additional,
            "credits": {
                "has_credits": bool(credits.get("has_credits")),
                "unlimited": bool(credits.get("unlimited")),
                "balance": credits.get("balance"),
                "overage_limit_reached": bool(
                    credits.get("overage_limit_reached")),
            },
            "rate_limit_reset_credits": {
                "available_count": openai_reset_credit_count(body),
                "details_complete": openai_reset_credit_details_complete(body),
                "next_expires_at": next_credit_expiry,
                "next_expires_in_seconds": (
                    max(0.0, next_credit_expiry - time.time())
                    if next_credit_expiry is not None else None
                ),
            }}


